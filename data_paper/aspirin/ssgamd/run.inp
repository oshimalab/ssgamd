[INPUT]
prmtopfile = ../system.prmtop
ambcrdfile = ../system.inpcrd
rstfile    = run0.rst

[OUTPUT]
dcdfile          = output/run1.dcd
rstfile          = output/run1.rst

[SSGAMD]
ssgamd = yes
boost = yes
thresh_type = LOWER
region = 1 2
sigma0_lj   = 0.5
update_period = 0
param_type = L
params_lj  = -3.7838        -28.2351        -20.8016          2.0018

[ENERGY]
forcefield       = AMBER
electrostatic    = PME
switchdist       = 9.0
cutoffdist       = 9.0
pairlistdist     = 10.5
pme_alpha        = auto
dispersion_corr  = EPRESS

[DYNAMICS]
integrator     = VVER
nsteps         = 250000000
timestep       = 0.004
eneout_period  = 2500
crdout_period  = 2500
rstout_period  = 250000
nbupdate_period   = 5
thermostat_period = 5
barostat_period   = 5
hydrogen_mr    = yes
hmr_target     = solute
hmr_ratio      = 2.5
hmr_ratio_xh1  = 2.0

[CONSTRAINTS]
rigid_bond       = YES
water_model      = WAT
shake_tolerance =  1.0E-08

[ENSEMBLE]
ensemble         = NVT 
temperature      = 300
tpcontrol        = BUSSI

[BOUNDARY]
type             = PBC
 
[SELECTION]
group1 = rno:1-7
group2 = rno:8
