[INPUT]
prmtopfile = ../system.prmtop
ambcrdfile = ../system.inpcrd
rstfile    = ../run0.rst

[OUTPUT]
dcdfile          = run1.dcd
rstfile          = run1.rst

[GAMD]
gamd = yes
boost = yes
thresh_type = LOWER
boost_type = DUAL
sigma0_pot = 6.0
sigma0_dih = 1.5
update_period = 0
pot_max = -16781.9824
pot_min = -17626.0977
pot_ave = -16967.2031
pot_dev = 63.2428
dih_max = 135.5647
dih_min = 98.9228
dih_ave = 119.5404
dih_dev = 3.0727

[ENERGY]
forcefield       = AMBER
electrostatic    = PME
switchdist       = 9.0
cutoffdist       = 9.0
pairlistdist     = 10.5
pme_alpha        = auto
dispersion_corr  = EPRESS

[DYNAMICS]
integrator     = VVER
nsteps         = 250000000
timestep       = 0.004
eneout_period  = 2500
crdout_period  = 2500
rstout_period  = 250000
nbupdate_period   = 5
thermostat_period = 5
barostat_period   = 5
hydrogen_mr    = yes
hmr_target     = solute
hmr_ratio      = 2.5
hmr_ratio_xh1  = 2.0

[CONSTRAINTS]
rigid_bond       = YES
water_model      = WAT

[ENSEMBLE]
ensemble         = NVT 
temperature      = 300
tpcontrol        = BUSSI

[BOUNDARY]
type             = PBC
