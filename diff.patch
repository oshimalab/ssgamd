+    integer,         pointer :: gamdgrp_dihe(:,:,:,:)
+
+    gamdgrp_nonb       => enefunc%ssgamd%gamdgrp_nonb
+    gamdgrp_dihe       => enefunc%ssgamd%gamdgrp_dihe
+
+    !
+    gamdgrp_nonb(:,:) = 0
+    gamdgrp_dihe(:,:,:,:) = 0
+
+    if (enefunc%ssgamd%pair) then
+      gamdgrp_nonb(2,3) = 1
+      gamdgrp_nonb(3,2) = 1
+      gamdgrp_dihe(2,2,2,2) = 1
+!      gamdgrp_dihe(2,2,2,3) = 1
+!      gamdgrp_dihe(2,2,3,2) = 1
+!      gamdgrp_dihe(2,2,3,3) = 1
+!      gamdgrp_dihe(2,3,2,2) = 1
+!      gamdgrp_dihe(2,3,2,3) = 1
+!      gamdgrp_dihe(2,3,3,2) = 1
+!      gamdgrp_dihe(2,3,3,3) = 1
+!      gamdgrp_dihe(3,2,2,2) = 1
+!      gamdgrp_dihe(3,2,2,3) = 1
+!      gamdgrp_dihe(3,2,3,2) = 1
+!      gamdgrp_dihe(3,2,3,3) = 1
+!      gamdgrp_dihe(3,3,2,2) = 1
+!      gamdgrp_dihe(3,3,2,3) = 1
+!      gamdgrp_dihe(3,3,3,2) = 1
+      gamdgrp_dihe(3,3,3,3) = 1
+    else
+      gamdgrp_nonb(2,2) = 1
+      gamdgrp_dihe(2,2,2,2) = 1
+    end if
+
+    return
+
+  end subroutine set_gamdgrp_nonb
+
 end module sp_enefunc_mod
