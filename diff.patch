@@ -0,0 +1,682 @@
+!--------1---------2---------3---------4---------5---------6---------7---------8
+!
+!  Module   sp_ssgamd_mod
+!> @brief   ssGaMD method
+!           Refs: Miao Y. et al., J. Chem. Theory Comput. 11, 3584 (2015)
+!                 Pang Y. et al., J. Chem. Theory Comput. 13, 9 (2017)
+!                 Oshima H., J. Chem. Info. Model. (2026)
+!! @authors Hiraku Oshima (HO)
+! 
+!  (c) Copyright 2026 University of Hyogo. All rights reserved.
+!
+!--------1---------2---------3---------4---------5---------6---------7---------8
+
+#ifdef HAVE_CONFIG_H
+#include "../config.h"
+#endif
+
+module sp_ssgamd_mod
+  use timers_mod
+  use select_mod
+  use select_atoms_mod
+  use select_atoms_str_mod
+  use molecules_str_mod
+  use string_mod
+  use sp_dynamics_str_mod
+  use sp_enefunc_str_mod
+  use sp_enefunc_gamd_mod
+  use sp_domain_str_mod
+  use sp_remd_str_mod
+  use fileio_control_mod
+  use messages_mod
+  use mpi_parallel_mod
+  use constants_mod
+#ifdef HAVE_MPI_GENESIS
+  use mpi
+#endif
+
+  implicit none
+  private
+
+  ! parameters for ssGAMD type
+  integer, public, parameter      :: ssGamdThreshLower = 1
+  integer, public, parameter      :: ssGamdThreshUpper = 2
+  character(*), public, parameter :: ssGamdThreshTypes(2)  = (/'LOWER         ', &
+                                                             'UPPER         '/)
+
+  ! structures
+  type, public :: s_ssgamd_info
+    logical  :: ssgamd          = .false.
+    logical  :: boost         = .true.
+    integer  :: thresh_type   = ssGamdThreshLower
+    character(MaxLine) :: region = ''
+    real(wp) :: sigma0_dih       = 6.0_wp
+    real(wp) :: sigma0_lj        = 6.0_wp
+    real(wp) :: sigma0_elec      = 6.0_wp
+    integer  :: update_period = 0
+    character(MaxLine) :: params_dih  = ''
+    character(MaxLine) :: params_lj   = ''
+    character(MaxLine) :: params_elec = ''
+    character(MaxLine) :: param_type  = ''
+    logical  :: pair     = .false.
+  end type s_ssgamd_info
+
+  ! public subroutines
+  public  :: show_ctrl_ssgamd
+  public  :: read_ctrl_ssgamd
+  public  :: setup_ssgamd
+  public  :: setup_gamdgrp
+  public  :: setup_enefunc_ssgamd
+
+contains
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+ 
+  subroutine show_ctrl_ssgamd(show_all, run_mode)
+
+    ! formal arguments
+    logical,                 intent(in)    :: show_all
+    character(*),            intent(in)    :: run_mode
+
+
+    if (show_all) then
+
+      select case (run_mode)
+
+      case ('md', 'remd')
+
+        write(MsgOut,'(A)') '[SSGAMD]'
+        write(MsgOut,'(A)') 'ssgamd        = no    # use of ssGaMD [yes, no]'
+        write(MsgOut,'(A)') 'thresh_type   = LOWER # threshold of ssGaMD [LOWER, UPPER]'
+        write(MsgOut,'(A)') 'sigma0        = 6.0   #'
+        write(MsgOut,'(A)') 'update_period = 0     # update period for ssGaMD parameter'
+        write(MsgOut,'(A)') '# max       = 0.0 # maximum of potential energy (kcal/mol)'
+        write(MsgOut,'(A)') '# min       = 0.0 # minimum of potential energy (kcal/mol)'
+        write(MsgOut,'(A)') '# ave       = 0.0 # average of potential energy (kcal/mol)'
+        write(MsgOut,'(A)') '# dev       = 0.0 # standard deviation of potential energy (kcal/mol)'
+        write(MsgOut,'(A)') '# boost         = yes # Boosting [yes, no]'
+        write(MsgOut,'(A)') ' '
+
+      end select
+
+    else
+
+      select case (run_mode)
+
+      case ('md', 'remd')
+
+        write(MsgOut,'(A)') '[SSGAMD]'
+        write(MsgOut,'(A)') 'ssgamd        = no    # use of ssGaMD [yes, no]'
+        write(MsgOut,'(A)') 'thresh_type   = LOWER # threshold of ssGaMD [LOWER, UPPER]'
+        write(MsgOut,'(A)') 'sigma0        = 6.0   #'
+        write(MsgOut,'(A)') 'update_period = 0     # update period for ssGaMD parameter'
+        write(MsgOut,'(A)') ' '
+
+      end select
+
+    end if
+
+    return
+
+  end subroutine show_ctrl_ssgamd
+  
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine read_ctrl_ssgamd(handle, ssgamd_info)
+
+    ! parameters
+    character(*),            parameter     :: Section = 'ssGamd'
+
+    ! formal arguments
+    integer,                 intent(in)    :: handle
+    type(s_ssgamd_info),       intent(inout) :: ssgamd_info
+
+    ! local variables
+
+
+    ! read parameters from control file
+    !
+    call begin_ctrlfile_section(handle, Section)
+
+    call read_ctrlfile_logical(handle, Section, 'ssgamd',  &
+                               ssgamd_info%ssgamd)
+    call read_ctrlfile_logical(handle, Section, 'boost',  &
+                               ssgamd_info%boost)
+    call read_ctrlfile_type   (handle, Section, 'thresh_type',   &
+                               ssgamd_info%thresh_type, ssgamdThreshTypes)
+    call read_ctrlfile_real   (handle, Section, 'sigma0_dih',    &
+                               ssgamd_info%sigma0_dih)
+    call read_ctrlfile_real   (handle, Section, 'sigma0_lj',    &
+                               ssgamd_info%sigma0_lj)
+    call read_ctrlfile_real   (handle, Section, 'sigma0_elec',    &
+                               ssgamd_info%sigma0_elec)
+    call read_ctrlfile_integer(handle, Section, 'update_period', &
+                               ssgamd_info%update_period)
+
+    call read_ctrlfile_string (handle, Section, 'region',  &
+                               ssgamd_info%region)
+
+    call read_ctrlfile_string (handle, Section, 'params_dih',  &
+                               ssgamd_info%params_dih)
+
+    call read_ctrlfile_string (handle, Section, 'params_lj',  &
+                               ssgamd_info%params_lj)
+
+    call read_ctrlfile_string (handle, Section, 'params_elec',  &
+                               ssgamd_info%params_elec)
+
+    call read_ctrlfile_string (handle, Section, 'param_type',  &
+                               ssgamd_info%param_type)
+
+    call end_ctrlfile_section(handle)
+
+    ! write parameters to MsgOut
+    !
+    if (main_rank) then
+
+      if (ssgamd_info%ssgamd) then
+
+        write(MsgOut,'(A)') 'Read_Ctrl_ssgamd> ssgamd information'
+
+        write(MsgOut,'(A20,F10.5)') &
+          '  sigma0_dih      = ', ssgamd_info%sigma0_dih
+        write(MsgOut,'(A20,F10.5)') &
+          '  sigma0_lj       = ', ssgamd_info%sigma0_lj
+        write(MsgOut,'(A20,F10.5)') &
+          '  sigma0_elec     = ', ssgamd_info%sigma0_elec
+
+        write(MsgOut,'(A20,A)') &
+          '  params_dih   = ', ssgamd_info%params_dih
+        write(MsgOut,'(A20,A)') &
+          '  params_lj    = ', ssgamd_info%params_lj
+        write(MsgOut,'(A20,A)') &
+          '  params_elec  = ', ssgamd_info%params_elec
+
+        if (ssgamd_info%thresh_type == ssgamdThreshLower) then
+          write(MsgOut,'(A)')   '  thresh_type      = LOWER'
+        else if (ssgamd_info%thresh_type == ssgamdThreshUpper) then
+          write(MsgOut,'(A)')   '  thresh_type      = UPPER'
+        end if
+
+        write(MsgOut,'(A20,I10)') &
+          '  update_period    = ', ssgamd_info%update_period
+
+        if (ssgamd_info%boost) then
+          write(MsgOut,'(A)')   '  boost            = YES'
+        else
+          write(MsgOut,'(A)')   '  boost            = NO'
+        end if
+
+        write(MsgOut,'(A)') ''
+
+      end if
+
+    end if
+
+    return
+
+  end subroutine read_ctrl_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine setup_ssgamd(ssgamd_info, sel_info, molecule, dynamics, domain, &
+                         enefunc, remd)
+
+    ! formal arguments
+    type(s_ssgamd_info),      intent(in)    :: ssgamd_info
+    type(s_sel_info),        intent(in)    :: sel_info
+    type(s_molecule),        intent(inout) :: molecule
+    type(s_dynamics),        intent(inout) :: dynamics
+    type(s_domain),          intent(inout) :: domain
+    type(s_enefunc),target,  intent(inout) :: enefunc
+    type(s_remd),  optional, intent(inout) :: remd
+
+    ! local variables
+    integer                  :: natom
+    integer                  :: alloc_stat
+    integer                  :: dealloc_stat
+    integer                  :: i, j, k
+    integer                  :: idx_select
+    type(s_selatoms),        allocatable :: selatoms(:)
+    type(s_enefunc_ssgamd),       pointer :: ssgamd
+    integer :: ndata
+    integer :: ierror
+    integer, parameter :: max_param_type = 20
+    character(MaxLine) :: param_type_str(max_param_type)
+    real(wp) :: params_data(4)
+
+    ssgamd => enefunc%ssgamd
+
+    if (.not. ssgamd_info%ssgamd) then
+      return
+    end if
+
+    ! initialize variables in ssgamd
+    !
+    call init_enefunc_ssgamd(ssgamd)
+    enefunc%ssgamd_use = ssgamd_info%ssgamd
+    domain%ssgamd_use = ssgamd_info%ssgamd
+    ssgamd%ssgamd_boost  = ssgamd_info%boost
+
+    ! setup threshold type
+    !
+    if (ssgamd_info%thresh_type == ssgamdThreshLower) then
+      ssgamd%thresh_lower = .true.
+    else if (ssgamd_info%thresh_type == ssgamdThreshUpper) then
+      ssgamd%thresh_upper = .true.
+    end if
+
+    ! read paramter type
+    !
+    ndata = split_num(ssgamd_info%param_type)
+    call split(ndata,max_param_type,ssgamd_info%param_type, param_type_str)
+
+    ssgamd%sw_dihedrals    = .false.
+    ssgamd%sw_lj           = .false.
+    ssgamd%sw_charge       = .false.
+
+    do j = 1, ndata
+      call tolower(param_type_str(j))
+      select case (trim(param_type_str(j)))
+        case("all")
+          ssgamd%sw_dihedrals    = .true.
+          ssgamd%sw_lj           = .true.
+          ssgamd%sw_charge       = .true.
+        case("d", "dihedral", "dihedrals")
+          ssgamd%sw_dihedrals    = .true.
+        case("c", "charge", "charges")
+          ssgamd%sw_charge       = .true.
+        case("l", "lj", "ljs")
+          ssgamd%sw_lj           = .true.
+      end select
+    end do
+
+    ! read paramters
+    !
+    ! dih
+    if (ssgamd%sw_dihedrals) then
+      ssgamd%sigma0_dih  = ssgamd_info%sigma0_dih
+      ndata = split_num(ssgamd_info%params_dih)
+      if (ndata == 4) then
+        call split(ndata,4,ssgamd_info%params_dih, params_data)
+        ssgamd%ene_max_dih = params_data(1)
+        ssgamd%ene_min_dih = params_data(2)
+        ssgamd%ene_ave_dih = params_data(3)
+        ssgamd%ene_dev_dih = params_data(4)
+      else
+        ssgamd%ene_max_dih  = -1.0d99
+        ssgamd%ene_min_dih  =  1.0d99
+        ssgamd%ene_ave_dih  =  0.0_dp
+        ssgamd%ene_dev_dih  =  0.0_dp
+      end if
+    end if
+    ! lj
+    if (ssgamd%sw_lj) then
+      ssgamd%sigma0_lj  = ssgamd_info%sigma0_lj
+      ndata = split_num(ssgamd_info%params_lj)
+      if (ndata == 4) then
+        call split(ndata,4,ssgamd_info%params_lj, params_data)
+        ssgamd%ene_max_lj = params_data(1)
+        ssgamd%ene_min_lj = params_data(2)
+        ssgamd%ene_ave_lj = params_data(3)
+        ssgamd%ene_dev_lj = params_data(4)
+      else
+        ssgamd%ene_max_lj  = -1.0d99
+        ssgamd%ene_min_lj  =  1.0d99
+        ssgamd%ene_ave_lj  =  0.0_dp
+        ssgamd%ene_dev_lj  =  0.0_dp
+      end if
+    end if
+    ! elec
+    if (ssgamd%sw_charge) then
+      ssgamd%sigma0_elec  = ssgamd_info%sigma0_elec
+      ndata = split_num(ssgamd_info%params_elec)
+      if (ndata == 4) then
+        call split(ndata,4,ssgamd_info%params_elec, params_data)
+        ssgamd%ene_max_elec = params_data(1)
+        ssgamd%ene_min_elec = params_data(2)
+        ssgamd%ene_ave_elec = params_data(3)
+        ssgamd%ene_dev_elec = params_data(4)
+      else
+        ssgamd%ene_max_elec  = -1.0d99
+        ssgamd%ene_min_elec  =  1.0d99
+        ssgamd%ene_ave_elec  =  0.0_dp
+        ssgamd%ene_dev_elec  =  0.0_dp
+      end if
+    end if
+
+    ! allocate enefunc for ssgamd
+    !
+    if (ssgamd%sw_dihedrals) then
+      call alloc_enefunc(enefunc, EneFuncssgamd_dih, MaxAtom, maxcell, nthread)
+    end if
+    if (ssgamd%sw_lj) then
+      call alloc_enefunc(enefunc, EneFuncssgamd_lj, MaxAtom, maxcell, nthread)
+    end if
+    if (ssgamd%sw_charge) then
+      call alloc_enefunc(enefunc, EneFuncssgamd_elec, MaxAtom, maxcell, nthread)
+    end if
+
+    ! setup update period
+    !
+    if (ssgamd_info%update_period > 0) then
+
+      ssgamd%update_period = ssgamd_info%update_period
+
+      if (present(remd)) then
+        ssgamd%update_period = 0
+        ssgamd%ssgamd_stat = .false.
+        if (main_rank) then
+          write(MsgOut,'(A)') 'Setup_ssGaMD> Parameter update is not allowed in &
+                               &ssGaMD-REUS'
+          write(MsgOut,'(A)') 'Setup_ssGaMD> ssGaMD parameters will not be updated'
+        end if
+      end if
+ 
+    else if (ssgamd_info%update_period == 0) then
+
+      ssgamd%update_period = 0
+      ssgamd%ssgamd_stat = .false.
+      if (main_rank) then
+        write(MsgOut,'(A)') 'Setup_ssGaMD> ssGaMD parameters will not be updated'
+      end if
+
+    else
+
+      call error_msg('Setup_ssGaMD> update_period should be non-negative integer')
+
+    end if
+
+
+    ! write the summary of setup ssGaMD parameters
+    ! (energy thresholds and force constants of boost potential)
+    !
+    if (main_rank) write(MsgOut,'(A)') 'Setup_ssGamd> ssGaMD initial parameters'
+
+    call setup_enefunc_ssgamd(ssgamd)
+
+    if (main_rank) then
+      if (ssgamd%sw_dihedrals) then
+        write(MsgOut,'(A20,F14.5)') '  ene_th_dih  = ', ssgamd%ene_th_dih
+        write(MsgOut,'(A20,F14.5)') '  kc_dih      = ', ssgamd%kc_dih
+      end if
+      if (ssgamd%sw_lj) then
+        write(MsgOut,'(A20,F14.5)') '  ene_th_lj   = ', ssgamd%ene_th_lj
+        write(MsgOut,'(A20,F14.5)') '  kc_lj       = ', ssgamd%kc_lj
+      end if
+      if (ssgamd%sw_charge) then
+        write(MsgOut,'(A20,F14.5)') '  ene_th_elec = ', ssgamd%ene_th_elec
+        write(MsgOut,'(A20,F14.5)') '  kc_elec     = ', ssgamd%kc_elec
+      end if
+    end if
+
+    if (main_rank) write(MsgOut,'(A)') ''
+
+    if (.not. ssgamd%ssgamd_boost) then
+      if (main_rank) then
+        write(MsgOut,'(A)') 'Setup_ssGaMD> ssGaMD boosting is not applied.'
+        write(MsgOut,'(A)') ''
+      end if
+    end if
+
+    if (ssgamd_info%update_period > 0) then
+      if (ssgamd%sw_dihedrals) then
+        ssgamd%ene_ave_dih = 0.0_dp
+        ssgamd%ene_dev_dih = 0.0_dp
+      end if
+      if (ssgamd%sw_lj) then
+        ssgamd%ene_ave_lj = 0.0_dp
+        ssgamd%ene_dev_lj = 0.0_dp
+      end if
+      if (ssgamd%sw_charge) then
+        ssgamd%ene_ave_elec = 0.0_dp
+        ssgamd%ene_dev_elec = 0.0_dp
+      end if
+    end if
+
+    return
+
+  end subroutine setup_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine setup_gamdgrp(ssgamd_info, sel_info, molecule)
+
+    ! formal arguments
+    type(s_ssgamd_info),      intent(inout) :: ssgamd_info
+    type(s_sel_info),        intent(in)    :: sel_info
+    type(s_molecule),        intent(inout) :: molecule
+
+    ! local variables
+    integer                  :: natom
+    integer                  :: alloc_stat
+    integer                  :: dealloc_stat
+    integer                  :: i, j, k
+    integer                  :: idx_select
+    type(s_selatoms)         :: selatoms
+    integer                  :: idata(2)
+    integer                  :: nregion
+
+    call setup_selection(sel_info, molecule)
+
+    allocate(molecule%gamdgrp(molecule%num_atoms))
+    molecule%gamdgrp(:) = 1
+
+    molecule%num_atoms_ssgamd = 0
+
+    nregion = split_num(ssgamd_info%region)
+
+    if (nregion < 1) then
+      call error_msg('Setup_ssGaMD> Error in region for ssGaMD')
+    else if (nregion == 1) then
+      read(ssgamd_info%region, *) idx_select
+      call select_atom(molecule, sel_info%groups(idx_select), &
+        selatoms)
+      natom = size(selatoms%idx)
+      do j = 1, natom
+        do k = 1, molecule%num_atoms
+          if(selatoms%idx(j) == k) then
+            molecule%gamdgrp(k) = 2
+          end if
+        end do
+      end do
+      molecule%num_atoms_ssgamd = size(selatoms%idx)
+
+    else if (nregion == 2) then
+
+      call split(nregion, 2, ssgamd_info%region, idata)
+
+      call select_atom(molecule, sel_info%groups(idata(1)), selatoms)
+      natom = size(selatoms%idx)
+      do j = 1, natom
+        do k = 1, molecule%num_atoms
+          if(selatoms%idx(j) == k) then
+            molecule%gamdgrp(k) = 2
+          end if
+        end do
+      end do
+      molecule%num_atoms_ssgamd = size(selatoms%idx)
+
+      call select_atom(molecule, sel_info%groups(idata(2)), selatoms)
+      natom = size(selatoms%idx)
+      do j = 1, natom
+        do k = 1, molecule%num_atoms
+          if(selatoms%idx(j) == k) then
+            molecule%gamdgrp(k) = 3
+          end if
+        end do
+      end do
+      molecule%num_atoms_ssgamd = molecule%num_atoms_ssgamd + size(selatoms%idx)
+
+      ssgamd_info%pair = .true.
+
+    end if
+
+    if (main_rank) then
+      write(MsgOut,'(A)')'Setup_ssGaMD> boost region is assigned for ssGaMD.'
+      write(MsgOut,'(A)') ' '
+    end if
+
+  end subroutine setup_gamdgrp
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine init_enefunc_ssgamd(ssgamd)
+
+    ! formal arguments
+    type(s_enefunc_ssgamd), intent(inout) :: ssgamd
+
+    ssgamd%ssgamd_stat               = .false.
+    ssgamd%ssgamd_boost              = .true.
+    ssgamd%thresh_lower            = .true.
+    ssgamd%thresh_upper            = .true.
+
+    ssgamd%ene_max_dih             = -1.0d99
+    ssgamd%ene_min_dih             =  1.0d99
+    ssgamd%ene_ave_dih             =  0.0_dp
+    ssgamd%ene_ave2_dih            =  0.0_dp
+    ssgamd%ene_dev_dih             =  0.0_dp
+    ssgamd%count_ssgamd_dih         =  1
+    ssgamd%ene_th_dih              = 0.0_dp
+
+    ssgamd%ene_max_lj             = -1.0d99
+    ssgamd%ene_min_lj             =  1.0d99
+    ssgamd%ene_ave_lj             =  0.0_dp
+    ssgamd%ene_ave2_lj            =  0.0_dp
+    ssgamd%ene_dev_lj             =  0.0_dp
+    ssgamd%count_ssgamd_lj         =  1
+    ssgamd%ene_th_lj              = 0.0_dp
+
+    ssgamd%ene_max_elec             = -1.0d99
+    ssgamd%ene_min_elec             =  1.0d99
+    ssgamd%ene_ave_elec             =  0.0_dp
+    ssgamd%ene_ave2_elec            =  0.0_dp
+    ssgamd%ene_dev_elec             =  0.0_dp
+    ssgamd%count_ssgamd_elec         =  1
+    ssgamd%ene_th_elec              = 0.0_dp
+
+    return
+
+  end subroutine init_enefunc_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine setup_enefunc_ssgamd(ssgamd)
+
+    ! formal arguments
+    type(s_enefunc_ssgamd), intent(inout) :: ssgamd
+
+    if (ssgamd%thresh_lower) then
+      ! dih
+      if (ssgamd%sw_dihedrals) then
+        call setup_enefunc_ssgamd_lower( &
+          ssgamd%ene_th_dih, ssgamd%kc_dih, ssgamd%k0_dih, &
+          ssgamd%ene_max_dih, ssgamd%ene_min_dih, ssgamd%ene_ave_dih, &
+          ssgamd%ene_dev_dih, ssgamd%sigma0_dih)
+      end if
+      ! lj
+      if (ssgamd%sw_lj) then
+        call setup_enefunc_ssgamd_lower( &
+          ssgamd%ene_th_lj, ssgamd%kc_lj, ssgamd%k0_lj, &
+          ssgamd%ene_max_lj, ssgamd%ene_min_lj, ssgamd%ene_ave_lj, &
+          ssgamd%ene_dev_lj, ssgamd%sigma0_lj)
+      end if
+      ! elec
+      if (ssgamd%sw_charge) then
+        call setup_enefunc_ssgamd_lower( &
+          ssgamd%ene_th_elec, ssgamd%kc_elec, ssgamd%k0_elec, &
+          ssgamd%ene_max_elec, ssgamd%ene_min_elec, ssgamd%ene_ave_elec, &
+          ssgamd%ene_dev_elec, ssgamd%sigma0_elec)
+      end if
+    else if (ssgamd%thresh_upper) then
+      ! dih
+      if (ssgamd%sw_dihedrals) then
+        call setup_enefunc_ssgamd_upper( &
+          ssgamd%ene_th_dih, ssgamd%kc_dih, ssgamd%k0_dih, &
+          ssgamd%ene_max_dih, ssgamd%ene_min_dih, ssgamd%ene_ave_dih, &
+          ssgamd%ene_dev_dih, ssgamd%sigma0_dih)
+      end if
+      ! lj
+      if (ssgamd%sw_lj) then
+        call setup_enefunc_ssgamd_upper( &
+          ssgamd%ene_th_lj, ssgamd%kc_lj, ssgamd%k0_lj, &
+          ssgamd%ene_max_lj, ssgamd%ene_min_lj, ssgamd%ene_ave_lj, &
+          ssgamd%ene_dev_lj, ssgamd%sigma0_lj)
+      end if
+      ! elec
+      if (ssgamd%sw_charge) then
+        call setup_enefunc_ssgamd_upper( &
+          ssgamd%ene_th_elec, ssgamd%kc_elec, ssgamd%k0_elec, &
+          ssgamd%ene_max_elec, ssgamd%ene_min_elec, ssgamd%ene_ave_elec, &
+          ssgamd%ene_dev_elec, ssgamd%sigma0_elec)
+      end if
+    end if
+
+    return
+
+  end subroutine setup_enefunc_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine setup_enefunc_ssgamd_lower(E_th, k, k0, E_max, E_min, E_ave, &
+                                      E_dev, sigma0)
+
+    ! formal arguments
+    real(dp),                 intent(inout) :: E_th
+    real(dp),                 intent(inout) :: k
+    real(dp),                 intent(inout) :: k0
+    real(dp),                 intent(in)    :: E_max
+    real(dp),                 intent(in)    :: E_min
+    real(dp),                 intent(in)    :: E_ave
+    real(dp),                 intent(in)    :: E_dev
+    real(dp),                 intent(in)    :: sigma0
+
+
+    E_th = E_max
+    if (abs(E_max-E_ave) > EPS) then
+      k0   = (sigma0/E_dev) * (E_max-E_min) / (E_max-E_ave)
+    else 
+      k0   = (sigma0/E_dev) * (E_max-E_min) / EPS
+    end if
+    k0   = min(1.0, k0)
+    if (abs(E_max-E_min) > EPS) then
+      k = k0 / (E_max-E_min)
+    else
+      k = k0 / EPS
+    end if
+
+    return
+
+  end subroutine setup_enefunc_ssgamd_lower
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine setup_enefunc_ssgamd_upper(E_th, k, k0, E_max, E_min, E_ave, &
+                                      E_dev, sigma0)
+
+    ! formal arguments
+    real(dp),                 intent(inout) :: E_th
+    real(dp),                 intent(inout) :: k
+    real(dp),                 intent(inout) :: k0
+    real(dp),                 intent(in)    :: E_max
+    real(dp),                 intent(in)    :: E_min
+    real(dp),                 intent(in)    :: E_ave
+    real(dp),                 intent(in)    :: E_dev
+    real(dp),                 intent(in)    :: sigma0
+
+
+    k0   = (1.0_dp - sigma0/E_dev) * (E_max-E_min) / (E_ave-E_min)
+    if ((k0 > 0.0_dp) .and. (k0 <= 1.0_dp)) then
+      E_th = E_min + (E_max-E_min)/k0
+    else
+      E_th = E_max
+      k0   = (sigma0/E_dev) * (E_max-E_min) / (E_ave-E_min)
+      k0   = min(1.0, k0)
+    end if
+    k = k0 / (E_max-E_min)
+
+    return
+
+  end subroutine setup_enefunc_ssgamd_upper
+
+end module sp_ssgamd_mod
