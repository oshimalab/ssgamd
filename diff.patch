+        viri(2) = viri(2) + dij(2)*work(2)
+        viri(3) = viri(3) + dij(3)*work(3)
+
+        force(1,ix,i,id+1) = force(1,ix,i,id+1) - work(1)
+        force(2,ix,i,id+1) = force(2,ix,i,id+1) - work(2)
+        force(3,ix,i,id+1) = force(3,ix,i,id+1) - work(3)
