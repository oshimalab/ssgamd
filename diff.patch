diff --git a/src/spdyn/sp_energy_ssgamd.fpp b/src/spdyn/sp_energy_ssgamd.fpp
new file mode 100644
index 0000000..819f40a
--- /dev/null
+++ b/src/spdyn/sp_energy_ssgamd.fpp
@@ -0,0 +1,411 @@
+!--------1---------2---------3---------4---------5---------6---------7---------8
+!
+!  Module   sp_energy_ssgamd_mod
+!> @brief   compute energy for ssGaMD
+!! @authors Hiraku Oshima (HO)
+!  
+!  (c) Copyright 2026 University of Hyogo. All rights reserved.
+!
+!--------1---------2---------3---------4---------5---------6---------7---------8
+
+#ifdef HAVE_CONFIG_H
+#include "../config.h"
+#endif
+
+module sp_energy_ssgamd_mod
+
+  use sp_energy_restraints_mod
+  use sp_energy_dihedrals_mod
+  use sp_enefunc_str_mod
+  use sp_energy_str_mod
+  use sp_restraints_str_mod
+  use sp_domain_str_mod
+  use sp_boundary_str_mod
+  use fileio_control_mod
+  use messages_mod
+  use mpi_parallel_mod
+  use constants_mod
+  use math_libs_mod
+  use string_mod
+#ifdef HAVE_MPI_GENESIS
+  use mpi
+#endif
+
+  implicit none
+  private
+
+  ! subroutines
+  public :: compute_boost_potential_ssgamd
+  public :: compute_stat_ssgamd
+  public :: boost_ssgamd
+
+contains
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+  !
+  !  Subroutine    compute_boost_potential_ssgamd
+  !> @brief        compute boost potential in ssGaMD
+  !! @authors      HO
+  !! @param[in]    ene     : input energy
+  !! @param[in]    k       : boost parameter for ssGaMD
+  !! @param[in]    ene_th  : energy threshold for ssGaMD
+  !! @param[out]   e_gamd  : boost potential
+  !! @param[put]   w_gamd  : boost coefficient for force
+  !
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_boost_potential_ssgamd(ene, k, ene_th, e_ssgamd, w_ssgamd)
+
+    ! formal arguments
+    real(dp),                intent(in)  :: ene
+    real(dp),                intent(in)  :: k
+    real(dp),                intent(in)  :: ene_th
+    real(dp),                intent(out) :: e_ssgamd
+    real(wp),                intent(out) :: w_ssgamd
+
+    ! local variables
+    real(dp) :: ev, factor
+
+
+    e_ssgamd = 0.0_dp
+    if (ene < ene_th) then
+      ev = ene - ene_th
+      factor = k * ev
+      e_ssgamd = factor * 0.5_dp * ev
+      w_ssgamd = real(factor, wp)
+    else
+      w_ssgamd = 0.0_wp
+    end if
+
+    return
+
+  end subroutine compute_boost_potential_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+  !
+  !  Subroutine    compute_stat_ssgamd
+  !> @brief        compute statistics for ssGaMD
+  !! @authors      HO
+  !! @param[in]    E       : input energy
+  !! @param[inout] E_max   : maximum energy
+  !! @param[inout] E_min   : minimum energy
+  !! @param[inout] E_ave   : average of energy
+  !! @param[inout] E_ave2  : average of square energy
+  !! @param[inout] E_dev   : deviation of energy
+  !! @param[inout] counter : number of samples
+  !
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_stat_ssgamd(E, E_max, E_min, E_ave, E_ave2, E_dev, counter)
+
+    ! formal arguments
+    real(dp),                intent(in)    :: E
+    real(dp),                intent(inout) :: E_max
+    real(dp),                intent(inout) :: E_min
+    real(dp),                intent(inout) :: E_ave
+    real(dp),                intent(inout) :: E_ave2
+    real(dp),                intent(inout) :: E_dev
+    integer,                 intent(inout) :: counter
+
+    ! local variables
+    real(dp) :: E_diff
+
+
+    if (E > E_max) E_max = E
+    if (E < E_min) E_min = E
+
+    E_diff = E - E_ave
+    E_ave  = E_ave  + E_diff/real(counter, dp)
+    E_ave2 = E_ave2 + E_diff * (E - E_ave)
+    E_dev = dsqrt(E_ave2/real(counter, dp))
+    counter = counter + 1
+
+    return
+
+  end subroutine compute_stat_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+  !
+  !  Subroutine    boost_ssgamd
+  !> @brief        boost the potential energy using ssGaMD method
+  !! @authors      HO
+  !! @param[in]    domain     : domain information
+  !! @param[inout] enefunc    : potential energy functions information
+  !! @param[inout] energy     : energy information
+  !! @param[inout] force      : forces of target systems
+  !! @param[inout] virial     : virial term of target systems
+  !
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine boost_ssgamd(domain, enefunc, coord, energy, force, virial)
+
+    ! formal arguments
+    type(s_domain), target,  intent(in)    :: domain
+    type(s_enefunc),target,  intent(inout) :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+    type(s_energy),          intent(inout) :: energy
+    real(wip),               intent(inout) :: force(:,:,:)
+    real(dp),                intent(inout) :: virial(3,3)
+
+    ! local variable
+    integer                  :: ncell, natom, id, i, ix, ic, jc, k
+    real(wp)                 :: f_tmp(1:3), f_tmp2(1:3)
+    real(wp)                 :: w_ssgamd_dih, w_ssgamd_lj, w_ssgamd_elec
+    real(dp)                 :: ene_dih, ene_lj, ene_elec
+    real(dp)                 :: before_reduce(3), after_reduce(3)
+    real(wip)                :: trans(1:3)
+    integer                  :: omp_get_thread_num
+
+    type(s_enefunc_ssgamd), pointer :: ssgamd
+    real(wp),              pointer :: coord_pbc(:,:,:)
+
+    ssgamd => enefunc%ssgamd
+    coord_pbc => domain%translated_ssgamd
+
+    ! number of cells and atoms
+    !
+    ncell = domain%num_cell_local + domain%num_cell_boundary
+    natom = domain%max_num_atom
+
+    ! Initialize
+    ene_dih  = 0.0_dp
+    ene_lj   = 0.0_dp
+    ene_elec = 0.0_dp
+
+    ! Reduce potential energy or dihedral energy.
+    !
+#ifdef HAVE_MPI_GENESIS
+    if (ssgamd%sw_dihedrals) then
+      do id = 1, nthread
+        ene_dih = ene_dih + ssgamd%edihed_omp(id)
+      end do
+    end if
+    if (ssgamd%sw_lj) then
+      do id = 1, nthread
+        ene_lj = ene_lj + ssgamd%evdw_omp(id)
+      end do
+    end if
+    if (ssgamd%sw_charge) then
+      do id = 1, nthread
+        ene_elec = ene_elec + ssgamd%eelec_omp(id)
+      end do
+    end if
+    before_reduce(1) = ene_dih
+    before_reduce(2) = ene_lj
+    before_reduce(3) = ene_elec
+    call mpi_allreduce(before_reduce, after_reduce, 3, mpi_real8,  &
+      mpi_sum, mpi_comm_country, ierror)
+    ene_dih  = after_reduce(1)
+    ene_lj   = after_reduce(2)
+    ene_elec = after_reduce(3)
+#else
+    if (ssgamd%sw_dihedrals) then
+      do id = 1, nthread
+        ene_dih = ene_dih + ssgamd%edihed_omp(id)
+      end do
+    end if
+    if (ssgamd%sw_lj) then
+      do id = 1, nthread
+        ene_lj = ene_lj + ssgamd%evdw_omp(id)
+      end do
+    end if
+    if (ssgamd%sw_charge) then
+      do id = 1, nthread
+        ene_elec = ene_elec + ssgamd%eelec_omp(id)
+      end do
+    end if
+#endif
+
+!    print *, ene, ssgamd%edihed_omp(1), ssgamd%eelec_omp(1), ssgamd%evdw_omp(1)
+!    print *, ene_lj, ene_elec, ssgamd%eelec_omp(1), ssgamd%evdw_omp(1)
+!    print *, ene, ssgamd%evdw_omp(1)
+!    print *, ene, ssgamd%edihed_omp(1)
+
+    ! Compute statistics
+    !
+    if (ssgamd%ssgamd_stat) then
+
+      ! Compute statistics of energy (i.e., max, min, ave, sd)
+      ! for updating the ssgamd parameters.
+      !
+      if (ssgamd%sw_dihedrals) then
+        call compute_stat_ssgamd(ene_dih, ssgamd%ene_max_dih, ssgamd%ene_min_dih, &
+          ssgamd%ene_ave_dih, ssgamd%ene_ave2_dih, ssgamd%ene_dev_dih,       &
+          ssgamd%count_ssgamd_dih)
+      end if
+      if (ssgamd%sw_lj) then
+        call compute_stat_ssgamd(ene_lj, ssgamd%ene_max_lj, ssgamd%ene_min_lj, &
+          ssgamd%ene_ave_lj, ssgamd%ene_ave2_lj, ssgamd%ene_dev_lj,       &
+          ssgamd%count_ssgamd_lj)
+      end if
+      if (ssgamd%sw_charge) then
+        call compute_stat_ssgamd(ene_elec, ssgamd%ene_max_elec, ssgamd%ene_min_elec, &
+          ssgamd%ene_ave_elec, ssgamd%ene_ave2_elec, ssgamd%ene_dev_elec,       &
+          ssgamd%count_ssgamd_elec)
+      end if
+
+    end if
+
+    ! Skip boosting or not
+    !
+    if (.not. ssgamd%ssgamd_boost) then
+      return
+    end if
+
+    ! Boost potential and force
+    !
+    if (ssgamd%sw_dihedrals) then
+
+      ! Compute boost potential and weight of force.
+      !
+      call compute_boost_potential_ssgamd(ene_dih, ssgamd%kc_dih, ssgamd%ene_th_dih, &
+        energy%ssgamd_dih, w_ssgamd_dih)
+
+      ! Reweight force and virial
+      !
+      !$omp parallel do default(shared) private(id, i, ix, f_tmp) &
+      !$omp schedule(dynamic,1) &
+      !$omp reduction(+:virial)
+      do i = 1, ncell
+        do ix = 1, domain%num_atom(i)
+          f_tmp(1:3) = ssgamd%f_dihe_omp(1:3,ix,i,1)
+          do id = 2, nthread
+            f_tmp(1:3) = f_tmp(1:3) + ssgamd%f_dihe_omp(1:3,ix,i,id)
+          end do
+          force(1:3,ix,i) = force(1:3,ix,i) + w_ssgamd_dih * f_tmp(1:3)
+        end do
+      end do
+
+      !$omp end parallel do
+      do id = 1, nthread
+        virial(1:3,1:3) = virial(1:3,1:3) + w_ssgamd_dih * ssgamd%v_dihe_omp(1:3,1:3,id)
+      end do
+
+    end if
+
+    if (ssgamd%sw_charge .or. ssgamd%sw_lj) then
+
+      !$omp parallel default(shared) private(id, i, ix)
+#ifdef OMP
+      id = omp_get_thread_num()
+#else
+      id = 0
+#endif
+      do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+        do ix = 1, domain%num_atom(i)
+          coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+          coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+          coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+        end do
+      end do
+      !$omp end parallel
+
+      if (ssgamd%sw_lj) then
+
+        ! Compute boost potential and weight of force.
+        !
+        call compute_boost_potential_ssgamd(ene_lj, ssgamd%kc_lj, ssgamd%ene_th_lj, &
+          energy%ssgamd_lj, w_ssgamd_lj)
+!        print *, energy%ssgamd_lj
+
+        ! Reweight force and virial
+        !
+        !$omp parallel do default(shared) private(id, i, ix, f_tmp, f_tmp2) &
+        !$omp schedule(dynamic,1) &
+        !$omp reduction(+:virial)
+        do i = 1, ncell
+          do ix = 1, domain%num_atom(i)
+            f_tmp(1:3) = ssgamd%f_lj(ix,1:3,i,1)
+            f_tmp2(1:3) = ssgamd%f_lj_omp(1:3,ix,i,1)
+            do id = 2, nthread
+              f_tmp(1:3) = f_tmp(1:3) + ssgamd%f_lj(ix,1:3,i,id)
+              f_tmp2(1:3) = f_tmp2(1:3) + ssgamd%f_lj_omp(1:3,ix,i,id)
+            end do
+            force(1:3,ix,i) = force(1:3,ix,i) + w_ssgamd_lj * (f_tmp(1:3) + f_tmp2(1:3))
+            do k = 1, 3
+              virial(k,k) = virial(k,k) + coord_pbc(ix,k,i)*w_ssgamd_lj*f_tmp(k)
+            end do
+          end do
+        end do
+        !$omp end parallel do
+
+        !$omp parallel default(shared) private(id, i, ix, ic, jc, trans, k)
+#ifdef OMP
+        id = omp_get_thread_num()
+#else
+        id = 0
+#endif
+        do i = id+1, maxcell, nthread
+          ic = domain%cell_pairlist1(1,i)
+          jc = domain%cell_pairlist1(2,i)
+          if (domain%virial_check(jc,ic)==1) then
+            trans(1:3) = domain%cell_move(1:3,jc,ic) * domain%system_size(1:3)
+            do k = 1, 3
+              ssgamd%v_lj_omp(k,k,id+1) = ssgamd%v_lj_omp(k,k,id+1) - trans(k)*ssgamd%v_lj(k,i)
+            end do
+          end if
+        end do
+        !$omp end parallel
+
+        do id = 1, nthread
+          virial(1:3,1:3) = virial(1:3,1:3) + w_ssgamd_lj * ssgamd%v_lj_omp(1:3,1:3,id)
+        end do
+
+      end if
+
+      if (ssgamd%sw_charge) then
+        ! Compute boost potential and weight of force.
+        !
+        call compute_boost_potential_ssgamd(ene_elec, ssgamd%kc_elec, ssgamd%ene_th_elec, &
+          energy%ssgamd_elec, w_ssgamd_elec)
+
+        ! Reweight force and virial
+        !
+        !$omp parallel do default(shared) private(id, i, ix, f_tmp, f_tmp2) &
+        !$omp schedule(dynamic,1) &
+        !$omp reduction(+:virial)
+        do i = 1, ncell
+          do ix = 1, domain%num_atom(i)
+            f_tmp(1:3) = ssgamd%f_elec(ix,1:3,i,1)
+            f_tmp2(1:3) = ssgamd%f_elec_omp(1:3,ix,i,1)
+            do id = 2, nthread
+              f_tmp(1:3) = f_tmp(1:3) + ssgamd%f_elec(ix,1:3,i,id)
+              f_tmp2(1:3) = f_tmp2(1:3) + ssgamd%f_elec_omp(1:3,ix,i,id)
+            end do
+            force(1:3,ix,i) = force(1:3,ix,i) + w_ssgamd_elec * (f_tmp(1:3) + f_tmp2(1:3))
+            do k = 1, 3
+              virial(k,k) = virial(k,k) + coord_pbc(ix,k,i)*w_ssgamd_elec*f_tmp(k)
+            end do
+          end do
+        end do
+        !$omp end parallel do
+
+        !$omp parallel default(shared) private(id, i, ix, ic, jc, trans, k)
+#ifdef OMP
+        id = omp_get_thread_num()
+#else
+        id = 0
+#endif
+        do i = id+1, maxcell, nthread
+          ic = domain%cell_pairlist1(1,i)
+          jc = domain%cell_pairlist1(2,i)
+          if (domain%virial_check(jc,ic)==1) then
+            trans(1:3) = domain%cell_move(1:3,jc,ic) * domain%system_size(1:3)
+            do k = 1, 3
+              ssgamd%v_elec_omp(k,k,id+1) = ssgamd%v_elec_omp(k,k,id+1) - trans(k)*ssgamd%v_elec(k,i)
+            end do
+          end if
+        end do
+        !$omp end parallel
+
+        do id = 1, nthread
+          virial(1:3,1:3) = virial(1:3,1:3) + w_ssgamd_elec * ssgamd%v_elec_omp(1:3,1:3,id)
+        end do
+
+      end if
+
+    end if
+
+  end subroutine boost_ssgamd
+
+end module sp_energy_ssgamd_mod
