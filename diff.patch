+++ b/src/spdyn/sp_energy_nonbond_ssgamd.fpp
@@ -0,0 +1,1790 @@
+!--------1---------2---------3---------4---------5---------6---------7---------8
+!
+!  Module   sp_energy_nonbond_ssgamd_mod
+!> @brief   calculate nonbonded energy with table and with linear interpolation
+!           for ssGaMD
+!! @authors Hiraku Oshima (HO)
+!  
+!  (c) Copyright 2026 University of Hyogo. All rights reserved.
+!
+!--------1---------2---------3---------4---------5---------6---------7---------8
+
+#ifdef HAVE_CONFIG_H
+#include "../config.h"
+#endif
+
+module sp_energy_nonbond_ssgamd_mod
+
+  use sp_pairlist_str_mod
+  use sp_enefunc_str_mod
+  use sp_domain_str_mod
+  use mpi_parallel_mod
+  use timers_mod
+  use constants_mod
+
+  implicit none
+  private
+
+  ! subroutines
+  !
+  public  :: compute_energy_nonbond_tbl_lnr_generic_ssgamd
+  public  :: compute_energy_nonbond_tbl_lnr_generic_charge_ssgamd
+  public  :: compute_energy_nonbond_tbl_lnr_generic_lj_ssgamd
+  public  :: compute_energy_nonbond_notbl_generic_ssgamd
+  public  :: compute_energy_nonbond_notbl_generic_charge_ssgamd
+  public  :: compute_energy_nonbond_notbl_generic_lj_ssgamd
+
+contains
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_tbl_lnr_generic_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2
+    real(wp)                  :: lj6, lj12
+    real(wp)                  :: R
+    real(wp)                  :: term_lj12, term_lj6, term_elec
+    real(wp)                  :: cutoff2, grad_coef
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: elec_temp, evdw_temp
+    real(wp)                  :: force_local_lj(3)
+    real(wp)                  :: force_local_elec(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: nonb_lj12(:,:), nonb_lj6(:,:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force_lj(:,:,:,:)
+    real(wp),         pointer :: force_elec(:,:,:,:)
+    real(dp),         pointer :: virial_lj(:,:)
+    real(dp),         pointer :: virial_elec(:,:)
+    real(dp),         pointer :: eelec(:)
+    real(dp),         pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nonb_lj12       => enefunc%nonb_lj12
+    nonb_lj6        => enefunc%nonb_lj6
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force_lj => enefunc%ssgamd%f_lj
+    force_elec => enefunc%ssgamd%f_elec
+    virial_lj => enefunc%ssgamd%v_lj
+    virial_elec => enefunc%ssgamd%v_elec
+    eelec => enefunc%ssgamd%eelec_omp
+    evdw => enefunc%ssgamd%evdw_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_lj12, term_lj6, term_elec, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, force_local_lj,       &
+    !$omp         force_local_elec, lj6,     &
+    !$omp         lj12, L1, elec_temp, evdw_temp, dij, check_virial)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local_lj(1:3) = 0.0_wp
+        force_local_elec(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+          lj6  = nonb_lj6(atmcls(ix,i),atmcls(iy,i))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,i))
+
+          L    = int(rij2)
+          R    = rij2 - L
+          L1   = 3*L - 2
+
+          term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1))
+          term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+          elec_temp = elec_temp + qtmp*charge(iy,i)*term_elec
+
+          ! Calculate force of lj
+          !
+          term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1))
+          term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_lj(1) = force_local_lj(1) - work(1)
+          force_local_lj(2) = force_local_lj(2) - work(2)
+          force_local_lj(3) = force_local_lj(3) - work(3)
+          force_lj(iy,1,i,id+1) = force_lj(iy,1,i,id+1) + work(1)
+          force_lj(iy,2,i,id+1) = force_lj(iy,2,i,id+1) + work(2)
+          force_lj(iy,3,i,id+1) = force_lj(iy,3,i,id+1) + work(3)
+
+          ! Calculate force of elec
+          !
+          term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+          grad_coef = qtmp*charge(iy,i)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_elec(1) = force_local_elec(1) - work(1)
+          force_local_elec(2) = force_local_elec(2) - work(2)
+          force_local_elec(3) = force_local_elec(3) - work(3)
+          force_elec(iy,1,i,id+1) = force_elec(iy,1,i,id+1) + work(1)
+          force_elec(iy,2,i,id+1) = force_elec(iy,2,i,id+1) + work(2)
+          force_elec(iy,3,i,id+1) = force_elec(iy,3,i,id+1) + work(3)
+        end do
+
+        force_lj(ix,1:3,i,id+1) = force_lj(ix,1:3,i,id+1) + force_local_lj(1:3)
+        force_elec(ix,1:3,i,id+1) = force_elec(ix,1:3,i,id+1) + force_local_elec(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local_lj(1:3) = 0.0_wp
+        force_local_elec(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+          lj6  = nonb_lj6 (atmcls(ix,i),atmcls(iy,j))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,j))
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          L1   = 3*L - 2
+          term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1))
+          term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+          term_elec = table_ene(L1+2) + R*(table_ene(L1+5)-table_ene(L1+2))
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+          elec_temp = elec_temp + qtmp*charge(iy,j)*term_elec
+
+          ! Calculte force of lj
+          !
+          term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1))
+          term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_lj(1) = force_local_lj(1) - work(1)
+          force_local_lj(2) = force_local_lj(2) - work(2)
+          force_local_lj(3) = force_local_lj(3) - work(3)
+
+          force_lj(iy,1,j,id+1) = force_lj(iy,1,j,id+1) + work(1)
+          force_lj(iy,2,j,id+1) = force_lj(iy,2,j,id+1) + work(2)
+          force_lj(iy,3,j,id+1) = force_lj(iy,3,j,id+1) + work(3)
+
+          ! Calculte force of elec
+          !
+          term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+          grad_coef = qtmp*charge(iy,j)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_elec(1) = force_local_elec(1) - work(1)
+          force_local_elec(2) = force_local_elec(2) - work(2)
+          force_local_elec(3) = force_local_elec(3) - work(3)
+
+          force_elec(iy,1,j,id+1) = force_elec(iy,1,j,id+1) + work(1)
+          force_elec(iy,2,j,id+1) = force_elec(iy,2,j,id+1) + work(2)
+          force_elec(iy,3,j,id+1) = force_elec(iy,3,j,id+1) + work(3)
+
+        end do
+
+        if (check_virial == 1) then
+          virial_lj(1:3,ij) = virial_lj(1:3,ij) - force_local_lj(1:3)
+          virial_elec(1:3,ij) = virial_elec(1:3,ij) - force_local_elec(1:3)
+        end if
+        force_lj(ix,1:3,i,id+1) = force_lj(ix,1:3,i,id+1) + force_local_lj(1:3)
+        force_elec(ix,1:3,i,id+1) = force_elec(ix,1:3,i,id+1) + force_local_elec(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_tbl_lnr_generic_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_tbl_lnr_generic_charge_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2
+    real(wp)                  :: R
+    real(wp)                  :: term_elec
+    real(wp)                  :: cutoff2, grad_coef
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: elec_temp
+    real(wp)                  :: force_local(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force(:,:,:,:)
+    real(dp),         pointer :: virial(:,:)
+    real(dp),         pointer :: eelec(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force => enefunc%ssgamd%f_elec
+    virial => enefunc%ssgamd%v_elec
+    eelec => enefunc%ssgamd%eelec_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_elec, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, force_local,      &
+    !$omp         L1, elec_temp,  dij, check_virial)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+
+          L    = int(rij2)
+          R    = rij2 - L
+          L1   = 3*L - 2
+
+          term_elec = table_ene(L1+2) + R*(table_ene(L1+5)-table_ene(L1+2))
+          elec_temp = elec_temp + qtmp*charge(iy,i)*term_elec
+
+          term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+          grad_coef = qtmp*charge(iy,i)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+          force(iy,1,i,id+1) = force(iy,1,i,id+1) + work(1)
+          force(iy,2,i,id+1) = force(iy,2,i,id+1) + work(2)
+          force(iy,3,i,id+1) = force(iy,3,i,id+1) + work(3)
+
+        end do
+
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          L1   = 3*L - 2
+          term_elec = table_ene(L1+2) + R*(table_ene(L1+5)-table_ene(L1+2))
+          elec_temp = elec_temp + qtmp*charge(iy,j)*term_elec
+
+          term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+          grad_coef = qtmp*charge(iy,j)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+
+          force(iy,1,j,id+1) = force(iy,1,j,id+1) + work(1)
+          force(iy,2,j,id+1) = force(iy,2,j,id+1) + work(2)
+          force(iy,3,j,id+1) = force(iy,3,j,id+1) + work(3)
+
+        end do
+
+        if (check_virial == 1) &
+          virial(1:3,ij) = virial(1:3,ij) - force_local(1:3)
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_tbl_lnr_generic_charge_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_tbl_lnr_generic_lj_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2
+    real(wp)                  :: lj6, lj12
+    real(wp)                  :: R
+    real(wp)                  :: term_lj12, term_lj6
+    real(wp)                  :: cutoff2, grad_coef
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: evdw_temp
+    real(wp)                  :: force_local(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: nonb_lj12(:,:), nonb_lj6(:,:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force(:,:,:,:)
+    real(dp),         pointer :: virial(:,:)
+    real(dp),         pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nonb_lj12       => enefunc%nonb_lj12
+    nonb_lj6        => enefunc%nonb_lj6
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force => enefunc%ssgamd%f_lj
+    virial => enefunc%ssgamd%v_lj
+    evdw => enefunc%ssgamd%evdw_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_lj12, term_lj6, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, force_local, lj6,     &
+    !$omp         lj12, L1, evdw_temp, dij, check_virial)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local(1:3) = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+          lj6  = nonb_lj6(atmcls(ix,i),atmcls(iy,i))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,i))
+
+          L    = int(rij2)
+          R    = rij2 - L
+          L1   = 3*L - 2
+
+          term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1))
+          term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+
+          term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1))
+          term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+          force(iy,1,i,id+1) = force(iy,1,i,id+1) + work(1)
+          force(iy,2,i,id+1) = force(iy,2,i,id+1) + work(2)
+          force(iy,3,i,id+1) = force(iy,3,i,id+1) + work(3)
+
+        end do
+
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local(1:3) = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          rij2  = cutoff2*density/rij2
+          lj6  = nonb_lj6 (atmcls(ix,i),atmcls(iy,j))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,j))
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          L1   = 3*L - 2
+          term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1))
+          term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+
+          term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1))
+          term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+
+          force(iy,1,j,id+1) = force(iy,1,j,id+1) + work(1)
+          force(iy,2,j,id+1) = force(iy,2,j,id+1) + work(2)
+          force(iy,3,j,id+1) = force(iy,3,j,id+1) + work(3)
+
+        end do
+
+        if (check_virial == 1) &
+          virial(1:3,ij) = virial(1:3,ij) - force_local(1:3)
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_tbl_lnr_generic_lj_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_notbl_generic_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2, rij2_inv
+    real(wp)                  :: lj6, lj12
+    real(wp)                  :: R
+    real(wp)                  :: term_lj12, term_lj6, term_elec
+    real(wp)                  :: cutoff2, grad_coef, within_cutoff
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: elec_temp, evdw_temp
+    real(wp)                  :: force_local_lj(3)
+    real(wp)                  :: force_local_elec(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: nonb_lj12(:,:), nonb_lj6(:,:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force_lj(:,:,:,:)
+    real(wp),         pointer :: force_elec(:,:,:,:)
+    real(dp),         pointer :: virial_lj(:,:)
+    real(dp),         pointer :: virial_elec(:,:)
+    real(dp),         pointer :: eelec(:)
+    real(dp),         pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nonb_lj12       => enefunc%nonb_lj12
+    nonb_lj6        => enefunc%nonb_lj6
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force_lj => enefunc%ssgamd%f_lj
+    force_elec => enefunc%ssgamd%f_elec
+    virial_lj => enefunc%ssgamd%v_lj
+    virial_elec => enefunc%ssgamd%v_elec
+    eelec => enefunc%ssgamd%eelec_omp
+    evdw => enefunc%ssgamd%evdw_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_lj12, term_lj6, term_elec, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, lj6,                  &
+    !$omp         lj12, L1, elec_temp, evdw_temp, dij, check_virial, rij2_inv, &
+    !$omp         within_cutoff, force_local_lj, force_local_elec)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local_lj(1:3) = 0.0_wp
+        force_local_elec(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+          lj6  = nonb_lj6(atmcls(ix,i),atmcls(iy,i))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,i))
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          term_lj6  = rij2_inv * rij2_inv * rij2_inv * within_cutoff
+          term_lj12 = term_lj6 * term_lj6
+          term_elec = table_ene(L) + R*(table_ene(L+1)-table_ene(L))
+          term_elec = term_elec * within_cutoff
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+          elec_temp = elec_temp + qtmp*charge(iy,i)*term_elec
+
+          ! Calculate force of lj
+          !
+          term_lj12 = -12.0_wp * term_lj12 * rij2_inv
+          term_lj6  = - 6.0_wp * term_lj6  * rij2_inv
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_lj(1) = force_local_lj(1) - work(1)
+          force_local_lj(2) = force_local_lj(2) - work(2)
+          force_local_lj(3) = force_local_lj(3) - work(3)
+          force_lj(iy,1,i,id+1) = force_lj(iy,1,i,id+1) + work(1)
+          force_lj(iy,2,i,id+1) = force_lj(iy,2,i,id+1) + work(2)
+          force_lj(iy,3,i,id+1) = force_lj(iy,3,i,id+1) + work(3)
+
+          ! Calculate force of elec
+          !
+          term_elec = table_grad(L) + R*(table_grad(L+1)-table_grad(L))
+          term_elec = term_elec * within_cutoff
+          grad_coef = qtmp*charge(iy,i)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_elec(1) = force_local_elec(1) - work(1)
+          force_local_elec(2) = force_local_elec(2) - work(2)
+          force_local_elec(3) = force_local_elec(3) - work(3)
+          force_elec(iy,1,i,id+1) = force_elec(iy,1,i,id+1) + work(1)
+          force_elec(iy,2,i,id+1) = force_elec(iy,2,i,id+1) + work(2)
+          force_elec(iy,3,i,id+1) = force_elec(iy,3,i,id+1) + work(3)
+
+        end do
+
+        force_lj(ix,1:3,i,id+1) = force_lj(ix,1:3,i,id+1) + force_local_lj(1:3)
+        force_elec(ix,1:3,i,id+1) = force_elec(ix,1:3,i,id+1) + force_local_elec(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local_lj(1:3) = 0.0_wp
+        force_local_elec(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+          lj6  = nonb_lj6 (atmcls(ix,i),atmcls(iy,j))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,j))
+  
+          L    = int(rij2)
+          R    = rij2 - L
+  
+          term_lj6  = rij2_inv * rij2_inv * rij2_inv * within_cutoff
+          term_lj12 = term_lj6 * term_lj6
+          term_elec = table_ene(L) + R*(table_ene(L+1)-table_ene(L))
+          term_elec = term_elec * within_cutoff
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+          elec_temp = elec_temp + qtmp*charge(iy,j)*term_elec
+  
+          ! Calcuate force of lj
+          !
+          term_lj12 = -12.0_wp * term_lj12 * rij2_inv
+          term_lj6  = - 6.0_wp * term_lj6  * rij2_inv
+          grad_coef = term_lj12*lj12 - term_lj6*lj6  
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+  
+          force_local_lj(1) = force_local_lj(1) - work(1)
+          force_local_lj(2) = force_local_lj(2) - work(2)
+          force_local_lj(3) = force_local_lj(3) - work(3)
+  
+          force_lj(iy,1,j,id+1) = force_lj(iy,1,j,id+1) + work(1)
+          force_lj(iy,2,j,id+1) = force_lj(iy,2,j,id+1) + work(2)
+          force_lj(iy,3,j,id+1) = force_lj(iy,3,j,id+1) + work(3)
+
+
+          ! Calculate force of elec
+          !
+          term_elec = table_grad(L) + R*(table_grad(L+1)-table_grad(L))
+          term_elec = term_elec * within_cutoff
+          grad_coef = qtmp*charge(iy,j)*term_elec
+  
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          force_local_elec(1) = force_local_elec(1) - work(1)
+          force_local_elec(2) = force_local_elec(2) - work(2)
+          force_local_elec(3) = force_local_elec(3) - work(3)
+  
+          force_elec(iy,1,j,id+1) = force_elec(iy,1,j,id+1) + work(1)
+          force_elec(iy,2,j,id+1) = force_elec(iy,2,j,id+1) + work(2)
+          force_elec(iy,3,j,id+1) = force_elec(iy,3,j,id+1) + work(3)
+   
+        end do
+
+        if (check_virial == 1) then
+          virial_lj(1:3,ij) = virial_lj(1:3,ij) - force_local_lj(1:3)
+          virial_elec(1:3,ij) = virial_elec(1:3,ij) - force_local_elec(1:3)
+        end if
+        force_lj(ix,1:3,i,id+1) = force_lj(ix,1:3,i,id+1) + force_local_lj(1:3)
+        force_elec(ix,1:3,i,id+1) = force_elec(ix,1:3,i,id+1) + force_local_elec(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_notbl_generic_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_notbl_generic_charge_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2, rij2_inv
+    real(wp)                  :: R
+    real(wp)                  :: term_elec
+    real(wp)                  :: cutoff2, grad_coef, within_cutoff
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: elec_temp
+    real(wp)                  :: force_local(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force(:,:,:,:)
+    real(dp),         pointer :: virial(:,:)
+    real(dp),         pointer :: eelec(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force => enefunc%ssgamd%f_elec
+    virial => enefunc%ssgamd%v_elec
+    eelec => enefunc%ssgamd%eelec_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_elec, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, force_local,      &
+    !$omp         L1, elec_temp, dij, check_virial, rij2_inv, &
+    !$omp         within_cutoff)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          term_elec = table_ene(L) + R*(table_ene(L+1)-table_ene(L))
+          term_elec = term_elec * within_cutoff
+          elec_temp = elec_temp + qtmp*charge(iy,i)*term_elec
+
+          term_elec = table_grad(L) + R*(table_grad(L+1)-table_grad(L))
+          term_elec = term_elec * within_cutoff
+          grad_coef = qtmp*charge(iy,i)*term_elec
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+          force(iy,1,i,id+1) = force(iy,1,i,id+1) + work(1)
+          force(iy,2,i,id+1) = force(iy,2,i,id+1) + work(2)
+          force(iy,3,i,id+1) = force(iy,3,i,id+1) + work(3)
+
+        end do
+
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local(1:3) = 0.0_wp
+        elec_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+  
+          L    = int(rij2)
+          R    = rij2 - L
+  
+          term_elec = table_ene(L) + R*(table_ene(L+1)-table_ene(L))
+          term_elec = term_elec * within_cutoff
+          elec_temp = elec_temp + qtmp*charge(iy,j)*term_elec
+  
+          term_elec = table_grad(L) + R*(table_grad(L+1)-table_grad(L))
+          term_elec = term_elec * within_cutoff
+          grad_coef = qtmp*charge(iy,j)*term_elec
+  
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+  
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+  
+          force(iy,1,j,id+1) = force(iy,1,j,id+1) + work(1)
+          force(iy,2,j,id+1) = force(iy,2,j,id+1) + work(2)
+          force(iy,3,j,id+1) = force(iy,3,j,id+1) + work(3)
+  
+        end do
+
+        if (check_virial == 1) &
+          virial(1:3,ij) = virial(1:3,ij) - force_local(1:3)
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        eelec(id+1) = eelec(id+1) + elec_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_notbl_generic_charge_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond_notbl_generic_lj_ssgamd( &
+                                                 domain, enefunc, pairlist)
+
+    ! formal arguments
+    type(s_domain),   target, intent(in)    :: domain
+    type(s_enefunc),  target, intent(inout) :: enefunc
+    type(s_pairlist), target, intent(in)    :: pairlist
+
+    ! local variables
+    real(wp)                  :: dij(1:3), rij2, rij2_inv
+    real(wp)                  :: lj6, lj12
+    real(wp)                  :: R
+    real(wp)                  :: term_lj12, term_lj6
+    real(wp)                  :: cutoff2, grad_coef, within_cutoff
+    real(wp)                  :: work(1:3)
+    real(wp)                  :: trans_x, trans_y, trans_z
+    real(wp)                  :: rtmp(1:3), qtmp
+    real(wp)                  :: evdw_temp
+    real(wp)                  :: force_local(3)
+    integer                   :: i, ix, iy, j, k, ij, iix, L, L1
+    integer                   :: num_nb15, ini_nb15, fin_nb15
+    integer                   :: id, omp_get_thread_num
+    integer                   :: ncell, ncell_local
+    integer                   :: check_virial
+
+    real(wip),        pointer :: coord(:,:,:)
+    real(wp),         pointer :: trans1(:,:,:), charge(:,:)
+    real(wp),         pointer :: system_size(:)
+    real(wp),         pointer :: nonb_lj12(:,:), nonb_lj6(:,:)
+    real(wp),         pointer :: density, cutoff
+    real(wp),         pointer :: table_ene(:), table_grad(:)
+    integer(1),       pointer :: cell_move(:,:,:)
+    integer,          pointer :: atmcls(:,:)
+    integer(int2),    pointer :: cell_pairlist(:,:)
+    integer,          pointer :: natom(:)
+    integer,          pointer :: nb15_list(:,:)
+    integer,          pointer :: nb15_cell(:)
+    integer,          pointer :: num_nb15_calc1(:,:), num_nb15_calc(:,:)
+    integer,          pointer :: nb15_calc_list1(:,:), nb15_calc_list(:,:)
+    integer(int1),    pointer :: virial_check(:,:)
+
+    real(wp),         pointer :: force(:,:,:,:)
+    real(dp),         pointer :: virial(:,:)
+    real(dp),         pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+
+    cell_pairlist   => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    coord           => domain%coord
+    trans1          => domain%trans_vec
+    charge          => domain%charge
+    cell_move       => domain%cell_move
+    system_size     => domain%system_size
+    virial_check    => domain%virial_check
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nonb_lj12       => enefunc%nonb_lj12
+    nonb_lj6        => enefunc%nonb_lj6
+
+    ncell           =  domain%num_cell_local + domain%num_cell_boundary
+    ncell_local     =  domain%num_cell_local
+    cutoff2         =  cutoff * cutoff
+
+    ! ssgamd
+    nb15_list       => pairlist%nb15_list_ssgamd
+    nb15_cell       => pairlist%nb15_cell_ssgamd
+    num_nb15_calc1  => pairlist%num_nb15_calc1_ssgamd
+    num_nb15_calc   => pairlist%num_nb15_calc_ssgamd
+    nb15_calc_list1 => pairlist%nb15_calc_list1_ssgamd
+    nb15_calc_list  => pairlist%nb15_calc_list_ssgamd
+
+    force => enefunc%ssgamd%f_lj
+    virial => enefunc%ssgamd%v_lj
+    evdw => enefunc%ssgamd%evdw_omp
+    coord_pbc => domain%translated_ssgamd
+
+    ! calculate energy and gradient
+    !
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, ix, num_nb15, rtmp, qtmp, ini_nb15, fin_nb15, k, iy,  &
+    !$omp         rij2, L, R, term_lj12, term_lj6, grad_coef, work, &
+    !$omp         ij, j, trans_x, trans_y, trans_z, iix, force_local, lj6,     &
+    !$omp         lj12, L1, evdw_temp, dij, check_virial, rij2_inv, &
+    !$omp         within_cutoff)
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    do i = id+1, ncell, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = coord(1,ix,i) + trans1(1,ix,i)
+        coord_pbc(ix,2,i) = coord(2,ix,i) + trans1(2,ix,i)
+        coord_pbc(ix,3,i) = coord(3,ix,i) + trans1(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! energy within a cell
+    !
+    do i = id+1, ncell_local, nthread
+
+      num_nb15 = 0
+      do ix = 1, natom(i) - 1
+
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+        ini_nb15  = num_nb15 + 1
+        fin_nb15  = num_nb15 + num_nb15_calc1(ix,i)
+        num_nb15  = fin_nb15
+        force_local(1:3) = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+
+          iy = nb15_calc_list1(k,i)
+
+          ! compute distance
+          !
+          dij(1) = rtmp(1) - coord_pbc(iy,1,i)
+          dij(2) = rtmp(2) - coord_pbc(iy,2,i)
+          dij(3) = rtmp(3) - coord_pbc(iy,3,i)
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+          lj6  = nonb_lj6(atmcls(ix,i),atmcls(iy,i))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,i))
+
+          L    = int(rij2)
+          R    = rij2 - L
+
+          term_lj6  = rij2_inv * rij2_inv * rij2_inv * within_cutoff
+          term_lj12 = term_lj6 * term_lj6
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+
+          term_lj12 = -12.0_wp * term_lj12 * rij2_inv
+          term_lj6  = - 6.0_wp * term_lj6  * rij2_inv
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+          force(iy,1,i,id+1) = force(iy,1,i,id+1) + work(1)
+          force(iy,2,i,id+1) = force(iy,2,i,id+1) + work(2)
+          force(iy,3,i,id+1) = force(iy,3,i,id+1) + work(3)
+
+        end do
+
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+
+    ! interaction between different cells
+    !
+    do ij = id+1, maxcell, nthread
+
+      i = cell_pairlist(1,ij)
+      j = cell_pairlist(2,ij)
+
+      num_nb15 = 0
+
+      ! ssgamd: shift for generic & gpu kernels
+      if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+          domain%nonbond_kernel /= NBK_Intel) then
+        trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+        trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+        trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+      else
+        trans_x = 0.0_wp
+        trans_y = 0.0_wp
+        trans_z = 0.0_wp
+      end if
+
+      check_virial = virial_check(j,i)
+
+      do iix = 1, nb15_cell(ij)
+
+        ix   = nb15_list(iix,ij)
+        rtmp(1) = coord_pbc(ix,1,i)
+        rtmp(2) = coord_pbc(ix,2,i)
+        rtmp(3) = coord_pbc(ix,3,i)
+        qtmp = charge(ix,i)
+
+        ini_nb15 = num_nb15 + 1
+        fin_nb15 = num_nb15 + num_nb15_calc(ix,ij)
+        num_nb15 = fin_nb15
+
+        force_local(1:3) = 0.0_wp
+        evdw_temp = 0.0_wp
+
+#if defined (FUGAKU)
+        !ocl norecurrence
+        !ocl swp
+#elif defined (INTEL)
+        !$omp simd
+#endif
+        do k = ini_nb15, fin_nb15
+          iy   = nb15_calc_list(k,ij)
+          dij(1) = rtmp(1) - coord_pbc(iy,1,j) + trans_x
+          dij(2) = rtmp(2) - coord_pbc(iy,2,j) + trans_y
+          dij(3) = rtmp(3) - coord_pbc(iy,3,j) + trans_z
+          rij2  = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+          within_cutoff = merge(0.0_wp,1.0_wp,rij2>cutoff2)
+
+          rij2_inv = 1.0_wp / rij2
+          rij2  = cutoff2*density*rij2_inv
+          lj6  = nonb_lj6 (atmcls(ix,i),atmcls(iy,j))
+          lj12 = nonb_lj12(atmcls(ix,i),atmcls(iy,j))
+  
+          L    = int(rij2)
+          R    = rij2 - L
+  
+          term_lj6  = rij2_inv * rij2_inv * rij2_inv * within_cutoff
+          term_lj12 = term_lj6 * term_lj6
+          evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+  
+          term_lj12 = -12.0_wp * term_lj12 * rij2_inv
+          term_lj6  = - 6.0_wp * term_lj6  * rij2_inv
+          grad_coef = term_lj12*lj12 - term_lj6*lj6
+  
+          work(1) = grad_coef*dij(1)
+          work(2) = grad_coef*dij(2)
+          work(3) = grad_coef*dij(3)
+  
+          ! store force
+          !
+          force_local(1) = force_local(1) - work(1)
+          force_local(2) = force_local(2) - work(2)
+          force_local(3) = force_local(3) - work(3)
+  
+          force(iy,1,j,id+1) = force(iy,1,j,id+1) + work(1)
+          force(iy,2,j,id+1) = force(iy,2,j,id+1) + work(2)
+          force(iy,3,j,id+1) = force(iy,3,j,id+1) + work(3)
+  
+        end do
+
+        if (check_virial == 1) &
+          virial(1:3,ij) = virial(1:3,ij) - force_local(1:3)
+        force(ix,1:3,i,id+1) = force(ix,1:3,i,id+1) + force_local(1:3)
+        evdw(id+1) = evdw(id+1) + evdw_temp
+
+      end do
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond_notbl_generic_lj_ssgamd
+
+end module sp_energy_nonbond_ssgamd_mod
