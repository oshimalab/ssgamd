+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_charmm_generic_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_lj12, term_lj6, term_elec
+    real(wp)                 :: cutoff2, grad_coef, lj12, lj6
+    real(wp)                 :: work(3), viri_lj(3), viri_elec(3)
+    real(wp)                 :: evdw_temp, elec_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L, L1
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: charge(:,:), system_size(:)
+    real(wp),        pointer :: nb14_lj12(:,:), nb14_lj6(:,:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force_lj(:,:,:,:)
+    real(wp),        pointer :: force_elec(:,:,:,:)
+    real(dp),        pointer :: virial_lj(:,:,:)
+    real(dp),        pointer :: virial_elec(:,:,:)
+    real(dp),        pointer :: eelec(:)
+    real(dp),        pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    charge          => domain%charge
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nb14_lj12       => enefunc%nb14_lj12
+    nb14_lj6        => enefunc%nb14_lj6
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+    force_lj => enefunc%ssgamd%f_lj_omp
+    virial_lj => enefunc%ssgamd%v_lj_omp
+    force_elec => enefunc%ssgamd%f_elec_omp
+    virial_elec => enefunc%ssgamd%v_elec_omp
+    eelec => enefunc%ssgamd%eelec_omp
+    evdw => enefunc%ssgamd%evdw_omp
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_lj12, term_lj6, term_elec, grad_coef,  &
+    !$omp         work, table, lj12, lj6, iatmcls, jatmcls, L1,                &
+    !$omp         evdw_temp, elec_temp, trans_x, trans_y, trans_z,             &
+    !$omp         viri_lj, viri_elec)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      evdw_temp = 0.0_wp
+      elec_temp = 0.0_wp
+      viri_lj(1:3) = 0.0_wp
+      viri_elec(1:3) = 0.0_wp
+     
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij) 
+        j  = nb14_calc_list(2,k,ij) 
+        ix = nb14_calc_list(3,k,ij) 
+        iy = nb14_calc_list(4,k,ij) 
+       
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1) = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2) = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3) = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2   = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        L1    = 3*L - 2
+
+        lj6   = nb14_lj6 (iatmcls,jatmcls)
+        lj12  = nb14_lj12(iatmcls,jatmcls)
+
+        term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1)  )
+        term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+        term_elec = table_ene(L1+2) + R*(table_ene(L1+5)-table_ene(L1+2))
+        evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+        elec_temp = elec_temp + charge(ix,i)*charge(iy,j)*term_elec
+
+        ! Calculate force of lj
+        !
+        term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1)  )
+        term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+        grad_coef = term_lj12*lj12 - term_lj6*lj6
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+        viri_lj(1) = viri_lj(1) + dij(1)*work(1)
+        viri_lj(2) = viri_lj(2) + dij(2)*work(2)
+        viri_lj(3) = viri_lj(3) + dij(3)*work(3)
+        force_lj(1,ix,i,id+1) = force_lj(1,ix,i,id+1) - work(1)
+        force_lj(2,ix,i,id+1) = force_lj(2,ix,i,id+1) - work(2)
+        force_lj(3,ix,i,id+1) = force_lj(3,ix,i,id+1) - work(3)
+        force_lj(1,iy,j,id+1) = force_lj(1,iy,j,id+1) + work(1)
+        force_lj(2,iy,j,id+1) = force_lj(2,iy,j,id+1) + work(2)
+        force_lj(3,iy,j,id+1) = force_lj(3,iy,j,id+1) + work(3)
+
+        ! Calculate force of elec
+        !
+        term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+        grad_coef = charge(ix,i)*charge(iy,j)*term_elec
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+        viri_elec(1) = viri_elec(1) + dij(1)*work(1)
+        viri_elec(2) = viri_elec(2) + dij(2)*work(2)
+        viri_elec(3) = viri_elec(3) + dij(3)*work(3)
+        force_elec(1,ix,i,id+1) = force_elec(1,ix,i,id+1) - work(1)
+        force_elec(2,ix,i,id+1) = force_elec(2,ix,i,id+1) - work(2)
+        force_elec(3,ix,i,id+1) = force_elec(3,ix,i,id+1) - work(3)
+        force_elec(1,iy,j,id+1) = force_elec(1,iy,j,id+1) + work(1)
+        force_elec(2,iy,j,id+1) = force_elec(2,iy,j,id+1) + work(2)
+        force_elec(3,iy,j,id+1) = force_elec(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial_lj(1,1,id+1) = virial_lj(1,1,id+1) - viri_lj(1)
+      virial_lj(2,2,id+1) = virial_lj(2,2,id+1) - viri_lj(2)
+      virial_lj(3,3,id+1) = virial_lj(3,3,id+1) - viri_lj(3)
+      virial_elec(1,1,id+1) = virial_elec(1,1,id+1) - viri_elec(1)
+      virial_elec(2,2,id+1) = virial_elec(2,2,id+1) - viri_elec(2)
+      virial_elec(3,3,id+1) = virial_elec(3,3,id+1) - viri_elec(3)
+      evdw(id+1)  = evdw(id+1) + evdw_temp
+      eelec(id+1) = eelec(id+1) + elec_temp
+
+    end do
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_charmm_generic_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_charmm_generic_charge_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_elec
+    real(wp)                 :: cutoff2, grad_coef
+    real(wp)                 :: work(3), viri(3)
+    real(wp)                 :: elec_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L, L1
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: charge(:,:), system_size(:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force(:,:,:,:)
+    real(dp),        pointer :: virial(:,:,:)
+    real(dp),        pointer :: eelec(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    charge          => domain%charge
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+    force => enefunc%ssgamd%f_elec_omp
+    virial => enefunc%ssgamd%v_elec_omp
+    eelec => enefunc%ssgamd%eelec_omp
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_elec, grad_coef,  &
+    !$omp         work, table, iatmcls, jatmcls, L1, viri,          &
+    !$omp         elec_temp, trans_x, trans_y, trans_z)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      elec_temp = 0.0_wp
+      viri(1:3) = 0.0_wp
+     
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij) 
+        j  = nb14_calc_list(2,k,ij) 
+        ix = nb14_calc_list(3,k,ij) 
+        iy = nb14_calc_list(4,k,ij) 
+       
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1) = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2) = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3) = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2   = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        L1    = 3*L - 2
+
+        term_elec = table_ene(L1+2) + R*(table_ene(L1+5)-table_ene(L1+2))
+        elec_temp = elec_temp + charge(ix,i)*charge(iy,j)*term_elec
+
+        term_elec = table_grad(L1+2) + R*(table_grad(L1+5)-table_grad(L1+2))
+        grad_coef = charge(ix,i)*charge(iy,j)*term_elec
+
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+
+        viri(1) = viri(1) + dij(1)*work(1)
+        viri(2) = viri(2) + dij(2)*work(2)
+        viri(3) = viri(3) + dij(3)*work(3)
+
+        force(1,ix,i,id+1) = force(1,ix,i,id+1) - work(1)
+        force(2,ix,i,id+1) = force(2,ix,i,id+1) - work(2)
+        force(3,ix,i,id+1) = force(3,ix,i,id+1) - work(3)
+        force(1,iy,j,id+1) = force(1,iy,j,id+1) + work(1)
+        force(2,iy,j,id+1) = force(2,iy,j,id+1) + work(2)
+        force(3,iy,j,id+1) = force(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial(1,1,id+1) = virial(1,1,id+1) - viri(1)
+      virial(2,2,id+1) = virial(2,2,id+1) - viri(2)
+      virial(3,3,id+1) = virial(3,3,id+1) - viri(3)
+      eelec(id+1) = eelec(id+1) + elec_temp
+
+    end do
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_charmm_generic_charge_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_charmm_generic_lj_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_lj12, term_lj6
+    real(wp)                 :: cutoff2, grad_coef, lj12, lj6
+    real(wp)                 :: work(3), viri(3)
+    real(wp)                 :: evdw_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L, L1
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: system_size(:)
+    real(wp),        pointer :: nb14_lj12(:,:), nb14_lj6(:,:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force(:,:,:,:)
+    real(dp),        pointer :: virial(:,:,:)
+    real(dp),        pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nb14_lj12       => enefunc%nb14_lj12
+    nb14_lj6        => enefunc%nb14_lj6
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+    force => enefunc%ssgamd%f_lj_omp
+    virial => enefunc%ssgamd%v_lj_omp
+    evdw => enefunc%ssgamd%evdw_omp
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_lj12, term_lj6, grad_coef,  &
+    !$omp         work, table, lj12, lj6, iatmcls, jatmcls, L1, viri,          &
+    !$omp         evdw_temp, trans_x, trans_y, trans_z)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      evdw_temp = 0.0_wp
+      viri(1:3) = 0.0_wp
+     
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij) 
+        j  = nb14_calc_list(2,k,ij) 
+        ix = nb14_calc_list(3,k,ij) 
+        iy = nb14_calc_list(4,k,ij) 
+       
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1) = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2) = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3) = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2   = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        L1    = 3*L - 2
+
+        lj6   = nb14_lj6 (iatmcls,jatmcls)
+        lj12  = nb14_lj12(iatmcls,jatmcls)
+
+        term_lj12 = table_ene(L1)   + R*(table_ene(L1+3)-table_ene(L1)  )
+        term_lj6  = table_ene(L1+1) + R*(table_ene(L1+4)-table_ene(L1+1))
+        evdw_temp = evdw_temp + term_lj12*lj12 - term_lj6*lj6
+
+        term_lj12 = table_grad(L1)   + R*(table_grad(L1+3)-table_grad(L1)  )
+        term_lj6  = table_grad(L1+1) + R*(table_grad(L1+4)-table_grad(L1+1))
+        grad_coef = term_lj12*lj12 - term_lj6*lj6
+
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+
+        viri(1) = viri(1) + dij(1)*work(1)
+        viri(2) = viri(2) + dij(2)*work(2)
+        viri(3) = viri(3) + dij(3)*work(3)
+
+        force(1,ix,i,id+1) = force(1,ix,i,id+1) - work(1)
+        force(2,ix,i,id+1) = force(2,ix,i,id+1) - work(2)
+        force(3,ix,i,id+1) = force(3,ix,i,id+1) - work(3)
+        force(1,iy,j,id+1) = force(1,iy,j,id+1) + work(1)
+        force(2,iy,j,id+1) = force(2,iy,j,id+1) + work(2)
+        force(3,iy,j,id+1) = force(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial(1,1,id+1) = virial(1,1,id+1) - viri(1)
+      virial(2,2,id+1) = virial(2,2,id+1) - viri(2)
+      virial(3,3,id+1) = virial(3,3,id+1) - viri(3)
+      evdw(id+1)  = evdw(id+1) + evdw_temp
+
+    end do
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_charmm_generic_lj_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_gro_amber_generic_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_lj12, term_lj6, term_elec
+    real(wp)                 :: cutoff2, grad_coef, lj12, lj6
+    real(wp)                 :: work(3), viri_lj(3), viri_elec(3)
+    real(wp)                 :: lj_scale, qq_scale, cc
+    real(wp)                 :: inv_r12, inv_r121, inv_r123, inv_r126, inv_r1212
+    real(wp)                 :: elec_temp, evdw_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: charge(:,:), system_size(:)
+    real(wp),        pointer :: nb14_lj12(:,:), nb14_lj6(:,:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force_lj(:,:,:,:)
+    real(wp),        pointer :: force_elec(:,:,:,:)
+    real(dp),        pointer :: virial_lj(:,:,:)
+    real(dp),        pointer :: virial_elec(:,:,:)
+    real(dp),        pointer :: eelec(:)
+    real(dp),        pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    charge          => domain%charge
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nb14_lj12       => enefunc%nb14_lj12
+    nb14_lj6        => enefunc%nb14_lj6
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    force_lj => enefunc%ssgamd%f_lj_omp
+    virial_lj => enefunc%ssgamd%v_lj_omp
+    force_elec => enefunc%ssgamd%f_elec_omp
+    virial_elec => enefunc%ssgamd%v_elec_omp
+    eelec => enefunc%ssgamd%eelec_omp
+    evdw => enefunc%ssgamd%evdw_omp
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_lj12, term_lj6, term_elec, grad_coef,  &
+    !$omp         work, table, lj12, lj6, qq_scale, lj_scale, cc, inv_r12,     &
+    !$omp         inv_r121, inv_r123, inv_r126, inv_r1212, iatmcls, jatmcls,   &
+    !$omp         evdw_temp, elec_temp, trans_x, trans_y, trans_z,             &
+    !$omp         viri_lj, viri_elec)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      evdw_temp = 0.0_wp
+      elec_temp = 0.0_wp
+      viri_lj(1:3) = 0.0_wp
+      viri_elec(1:3) = 0.0_wp
+
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij)
+        j  = nb14_calc_list(2,k,ij)
+        ix = nb14_calc_list(3,k,ij)
+        iy = nb14_calc_list(4,k,ij)
+
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1)   = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2)   = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3)   = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2     = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+        qq_scale = enefunc%nb14_qq_scale_ssgamd(k,ij)
+        lj_scale = enefunc%nb14_lj_scale_ssgamd(k,ij)
+        inv_r12  = 1.0_wp / rij2
+        inv_r121 = sqrt(inv_r12)
+        inv_r123 = inv_r12 * inv_r121
+        inv_r126 = inv_r123 * inv_r123
+        inv_r1212 = inv_r126 * inv_r126
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        lj6   = nb14_lj6 (iatmcls,jatmcls)
+        lj12  = nb14_lj12(iatmcls,jatmcls)
+        cc    = charge(ix,i)*charge(iy,j)*qq_scale
+
+        term_lj12   = inv_r1212
+        term_lj6    = inv_r126
+        term_elec   = table_ene(3*L) + R*(table_ene(3*L+3)-table_ene(3*L))
+        evdw_temp   = evdw_temp  + (term_lj12*lj12 - term_lj6*lj6)*lj_scale
+        elec_temp   = elec_temp  + cc*term_elec
+
+        ! Calculate force of lj
+        !
+        term_lj12   = -12.0_wp * inv_r1212 * inv_r12
+        term_lj6    = -6.0_wp * inv_r126 * inv_r12
+        grad_coef   = (term_lj12*lj12 - term_lj6*lj6)*lj_scale
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+        viri_lj(1) = viri_lj(1) + dij(1)*work(1)
+        viri_lj(2) = viri_lj(2) + dij(2)*work(2)
+        viri_lj(3) = viri_lj(3) + dij(3)*work(3)
+        force_lj(1,ix,i,id+1) = force_lj(1,ix,i,id+1) - work(1)
+        force_lj(2,ix,i,id+1) = force_lj(2,ix,i,id+1) - work(2)
+        force_lj(3,ix,i,id+1) = force_lj(3,ix,i,id+1) - work(3)
+        force_lj(1,iy,j,id+1) = force_lj(1,iy,j,id+1) + work(1)
+        force_lj(2,iy,j,id+1) = force_lj(2,iy,j,id+1) + work(2)
+        force_lj(3,iy,j,id+1) = force_lj(3,iy,j,id+1) + work(3)
+
+        ! Calculate force of elec
+        !
+        term_elec   = table_grad(3*L) + R*(table_grad(3*L+3)-table_grad(3*L))
+        grad_coef   = cc*term_elec
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+        viri_elec(1) = viri_elec(1) + dij(1)*work(1)
+        viri_elec(2) = viri_elec(2) + dij(2)*work(2)
+        viri_elec(3) = viri_elec(3) + dij(3)*work(3)
+        force_elec(1,ix,i,id+1) = force_elec(1,ix,i,id+1) - work(1)
+        force_elec(2,ix,i,id+1) = force_elec(2,ix,i,id+1) - work(2)
+        force_elec(3,ix,i,id+1) = force_elec(3,ix,i,id+1) - work(3)
+        force_elec(1,iy,j,id+1) = force_elec(1,iy,j,id+1) + work(1)
+        force_elec(2,iy,j,id+1) = force_elec(2,iy,j,id+1) + work(2)
+        force_elec(3,iy,j,id+1) = force_elec(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial_lj(1,1,id+1) = virial_lj(1,1,id+1) - viri_lj(1)
+      virial_lj(2,2,id+1) = virial_lj(2,2,id+1) - viri_lj(2)
+      virial_lj(3,3,id+1) = virial_lj(3,3,id+1) - viri_lj(3)
+      virial_elec(1,1,id+1) = virial_elec(1,1,id+1) - viri_elec(1)
+      virial_elec(2,2,id+1) = virial_elec(2,2,id+1) - viri_elec(2)
+      virial_elec(3,3,id+1) = virial_elec(3,3,id+1) - viri_elec(3)
+      evdw(id+1)  = evdw(id+1) + evdw_temp
+      eelec(id+1) = eelec(id+1) + elec_temp
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_gro_amber_generic_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_gro_amber_generic_charge_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_elec
+    real(wp)                 :: cutoff2, grad_coef
+    real(wp)                 :: work(3), viri(3)
+    real(wp)                 :: qq_scale, cc
+    real(wp)                 :: inv_r12, inv_r121, inv_r123, inv_r126, inv_r1212
+    real(wp)                 :: elec_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: charge(:,:), system_size(:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force(:,:,:,:)
+    real(dp),        pointer :: virial(:,:,:)
+    real(dp),        pointer :: eelec(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    charge          => domain%charge
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    force => enefunc%ssgamd%f_elec_omp
+    virial => enefunc%ssgamd%v_elec_omp
+    eelec => enefunc%ssgamd%eelec_omp
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_elec, grad_coef,  &
+    !$omp         work, table, qq_scale, cc, inv_r12,     &
+    !$omp         inv_r121, inv_r123, inv_r126, inv_r1212, iatmcls, jatmcls,   &
+    !$omp         elec_temp, viri, trans_x, trans_y, trans_z)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      elec_temp = 0.0_wp
+      viri(1:3) = 0.0_wp
+
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij)
+        j  = nb14_calc_list(2,k,ij)
+        ix = nb14_calc_list(3,k,ij)
+        iy = nb14_calc_list(4,k,ij)
+
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1)   = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2)   = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3)   = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2     = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+        qq_scale = enefunc%nb14_qq_scale_ssgamd(k,ij)
+        inv_r12  = 1.0_wp / rij2
+        inv_r121 = sqrt(inv_r12)
+        inv_r123 = inv_r12 * inv_r121
+        inv_r126 = inv_r123 * inv_r123
+        inv_r1212 = inv_r126 * inv_r126
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        cc    = charge(ix,i)*charge(iy,j)*qq_scale
+
+        term_elec   = table_ene(3*L) + R*(table_ene(3*L+3)-table_ene(3*L))
+        elec_temp   = elec_temp  + cc*term_elec
+
+        term_elec   = table_grad(3*L) + R*(table_grad(3*L+3)-table_grad(3*L))
+        grad_coef   = cc*term_elec
+
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+
+        viri(1) = viri(1) + dij(1)*work(1)
+        viri(2) = viri(2) + dij(2)*work(2)
+        viri(3) = viri(3) + dij(3)*work(3)
+
+        force(1,ix,i,id+1) = force(1,ix,i,id+1) - work(1)
+        force(2,ix,i,id+1) = force(2,ix,i,id+1) - work(2)
+        force(3,ix,i,id+1) = force(3,ix,i,id+1) - work(3)
+        force(1,iy,j,id+1) = force(1,iy,j,id+1) + work(1)
+        force(2,iy,j,id+1) = force(2,iy,j,id+1) + work(2)
+        force(3,iy,j,id+1) = force(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial(1,1,id+1) = virial(1,1,id+1) - viri(1)
+      virial(2,2,id+1) = virial(2,2,id+1) - viri(2)
+      virial(3,3,id+1) = virial(3,3,id+1) - viri(3)
+      eelec(id+1) = eelec(id+1) + elec_temp
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_gro_amber_generic_charge_ssgamd
+
+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine compute_energy_nonbond14_gro_amber_generic_lj_ssgamd(domain, enefunc, coord)
+
+    ! formal arguments
+    type(s_domain),  target, intent(inout) :: domain
+    type(s_enefunc), target, intent(in)    :: enefunc
+    real(wp),                intent(in)    :: coord(:,:,:)
+
+    ! local variables
+    real(wp)                 :: dij(3), rij2
+    real(wp)                 :: R, table(6)
+    real(wp)                 :: term_lj12, term_lj6
+    real(wp)                 :: cutoff2, grad_coef, lj12, lj6
+    real(wp)                 :: work(3), viri(3)
+    real(wp)                 :: lj_scale
+    real(wp)                 :: inv_r12, inv_r121, inv_r123, inv_r126, inv_r1212
+    real(wp)                 :: evdw_temp
+    integer                  :: i, ix, iy, j, k, ij, m, L
+    integer                  :: iatmcls, jatmcls
+    integer                  :: num_nb14, ini_nb14, fin_nb14
+    integer                  :: ncell_local, id, omp_get_thread_num
+
+    real(wp),        pointer :: system_size(:)
+    real(wp),        pointer :: nb14_lj12(:,:), nb14_lj6(:,:)
+    real(wp),        pointer :: table_ene(:), table_grad(:)
+    real(wp),        pointer :: density, cutoff
+    integer,         pointer :: natom(:), atmcls(:,:)
+    integer(int2),   pointer :: cell_pair(:,:)
+    integer,         pointer :: num_nb14_calc(:), nb14_calc_list(:,:,:)
+    integer(1),      pointer :: cell_move(:,:,:)
+
+    ! ssgamd
+    real(wp),        pointer :: force(:,:,:,:)
+    real(dp),        pointer :: virial(:,:,:)
+    real(dp),        pointer :: evdw(:)
+    real(wp),         pointer :: coord_pbc(:,:,:)
+    real(wp)                  :: trans_x, trans_y, trans_z
+
+    cell_pair       => domain%cell_pairlist1
+    atmcls          => domain%atom_cls_no
+    natom           => domain%num_atom
+    system_size     => domain%system_size
+    cell_move       => domain%cell_move
+
+    table_ene       => enefunc%table%table_ene
+    table_grad      => enefunc%table%table_grad
+    density         => enefunc%table%density
+    cutoff          => enefunc%cutoffdist
+    nb14_lj12       => enefunc%nb14_lj12
+    nb14_lj6        => enefunc%nb14_lj6
+
+    cutoff2         =  cutoff * cutoff
+    ncell_local     =  domain%num_cell_local
+
+    ! ssgamd
+    force => enefunc%ssgamd%f_lj_omp
+    virial => enefunc%ssgamd%v_lj_omp
+    evdw => enefunc%ssgamd%evdw_omp
+    num_nb14_calc   => enefunc%num_nb14_calc_ssgamd
+    nb14_calc_list  => enefunc%nb14_calc_list_ssgamd
+    coord_pbc      => domain%translated_ssgamd
+
+    !$omp parallel default(shared)                                             &
+    !$omp private(id, i, j, k, ij, ix, iy, m, ini_nb14, fin_nb14, num_nb14,    &
+    !$omp         dij, rij2, L, R, term_lj12, term_lj6, grad_coef,  &
+    !$omp         work, table, lj12, lj6, lj_scale, inv_r12,     &
+    !$omp         inv_r121, inv_r123, inv_r126, inv_r1212, iatmcls, jatmcls,   &
+    !$omp         evdw_temp, viri, trans_x, trans_y, trans_z)
+    !
+#ifdef OMP
+    id = omp_get_thread_num()
+#else
+    id = 0
+#endif
+    ! ssgamd: shift coord for pbc
+    do i = id+1, domain%num_cell_local + domain%num_cell_boundary, nthread
+      do ix = 1, natom(i)
+        coord_pbc(ix,1,i) = domain%coord(1,ix,i) + domain%trans_vec(1,ix,i)
+        coord_pbc(ix,2,i) = domain%coord(2,ix,i) + domain%trans_vec(2,ix,i)
+        coord_pbc(ix,3,i) = domain%coord(3,ix,i) + domain%trans_vec(3,ix,i)
+      end do
+    end do
+
+    !$omp barrier
+
+    ! calculate energy and gradient
+    !
+    do ij = id+1, ncell_local, nthread
+
+      evdw_temp = 0.0_wp
+      viri(1:3) = 0.0_wp
+
+      do k = 1, num_nb14_calc(ij)
+
+        i  = nb14_calc_list(1,k,ij)
+        j  = nb14_calc_list(2,k,ij)
+        ix = nb14_calc_list(3,k,ij)
+        iy = nb14_calc_list(4,k,ij)
+
+        iatmcls = atmcls(ix,i)
+        jatmcls = atmcls(iy,j)
+
+        ! ssgamd: shift for generic & gpu kernels
+        if (domain%nonbond_kernel /= NBK_Fugaku .and. &
+            domain%nonbond_kernel /= NBK_Intel) then
+          trans_x = real(cell_move(1,j,i),wp) * system_size(1)
+          trans_y = real(cell_move(2,j,i),wp) * system_size(2)
+          trans_z = real(cell_move(3,j,i),wp) * system_size(3)
+        else
+          trans_x = 0.0_wp
+          trans_y = 0.0_wp
+          trans_z = 0.0_wp
+        end if
+
+        ! compute distance
+        !
+        dij(1)   = coord_pbc(ix,1,i) - coord_pbc(iy,1,j)
+        dij(2)   = coord_pbc(ix,2,i) - coord_pbc(iy,2,j)
+        dij(3)   = coord_pbc(ix,3,i) - coord_pbc(iy,3,j)
+        dij(1) = dij(1) + trans_x
+        dij(2) = dij(2) + trans_y
+        dij(3) = dij(3) + trans_z
+        rij2     = dij(1)*dij(1) + dij(2)*dij(2) + dij(3)*dij(3)
+        lj_scale = enefunc%nb14_lj_scale_ssgamd(k,ij)
+        inv_r12  = 1.0_wp / rij2
+        inv_r121 = sqrt(inv_r12)
+        inv_r123 = inv_r12 * inv_r121
+        inv_r126 = inv_r123 * inv_r123
+        inv_r1212 = inv_r126 * inv_r126
+
+        ! energy and gradient
+        !
+        rij2  = cutoff2*density/rij2
+        L     = int(rij2)
+        R     = rij2 - L
+        lj6   = nb14_lj6 (iatmcls,jatmcls)
+        lj12  = nb14_lj12(iatmcls,jatmcls)
+
+        term_lj12   = inv_r1212
+        term_lj6    = inv_r126
+        evdw_temp   = evdw_temp  + (term_lj12*lj12 - term_lj6*lj6)*lj_scale
+
+        term_lj12   = -12.0_wp * inv_r1212 * inv_r12
+        term_lj6    = -6.0_wp * inv_r126 * inv_r12
+        grad_coef   = (term_lj12*lj12 - term_lj6*lj6)*lj_scale
+
+        work(1) = grad_coef*dij(1)
+        work(2) = grad_coef*dij(2)
+        work(3) = grad_coef*dij(3)
+
+        viri(1) = viri(1) + dij(1)*work(1)
+        viri(2) = viri(2) + dij(2)*work(2)
+        viri(3) = viri(3) + dij(3)*work(3)
+
+        force(1,ix,i,id+1) = force(1,ix,i,id+1) - work(1)
+        force(2,ix,i,id+1) = force(2,ix,i,id+1) - work(2)
+        force(3,ix,i,id+1) = force(3,ix,i,id+1) - work(3)
+        force(1,iy,j,id+1) = force(1,iy,j,id+1) + work(1)
+        force(2,iy,j,id+1) = force(2,iy,j,id+1) + work(2)
+        force(3,iy,j,id+1) = force(3,iy,j,id+1) + work(3)
+
+      end do
+
+      virial(1,1,id+1) = virial(1,1,id+1) - viri(1)
+      virial(2,2,id+1) = virial(2,2,id+1) - viri(2)
+      virial(3,3,id+1) = virial(3,3,id+1) - viri(3)
+      evdw(id+1)  = evdw(id+1) + evdw_temp
+
+    end do
+
+    !$omp end parallel
+
+    return
+
+  end subroutine compute_energy_nonbond14_gro_amber_generic_lj_ssgamd
+
 end module sp_energy_table_linear_mod
