+  !======1=========2=========3=========4=========5=========6=========7=========8
+
+  subroutine output_ssgamd(output, dynvars, enefunc)
+
+    ! formal arguments
+    type(s_output),          intent(inout) :: output
+    type(s_dynvars),         intent(in)    :: dynvars
+    type(s_enefunc),target,  intent(in)    :: enefunc
+
+    ! local variables
+    integer,parameter            :: clength=16, flength=4
+    integer                      :: i, ifm
+    character(16)                :: title
+    character(16)                :: category(999)
+    character                    :: frmt*5, rfrmt*7
+    character                    :: rfrmt_cont*9, frmt_cont*7
+    real(wp)                     :: values(999)
+    logical, save                :: ssgamdtitle = .true.
+    type(s_enefunc_ssgamd),pointer :: ssgamd
+
+
+    ssgamd => enefunc%ssgamd
+
+    write(title,'(A16)') 'STEP'
+    write(frmt,'(A2,I2,A)') '(A',clength,')'
+    write(frmt_cont,'(A2,I2,A3)') '(A',clength,',$)'
+    write(rfrmt,'(A2,I2,A1,I1,A1)') '(F',clength,'.',flength,')'
+    write(rfrmt_cont,'(A2,I2,A1,I1,A3)') '(F',clength,'.',flength,',$)'
+
+
+    if (.not. main_rank) return
+
+    if (output%ssgamdout) then
+
+        ifm = 1
+
+        if (ssgamd%sw_dihedrals) then
+          write(category(ifm),frmt) 'MAX_DIH'
+          values(ifm) = ssgamd%ene_max_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'MIN_DIH'
+          values(ifm) = ssgamd%ene_min_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'AVE_DIH'
+          values(ifm) = ssgamd%ene_ave_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'DEV_DIH'
+          values(ifm) = ssgamd%ene_dev_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'TH_DIH'
+          values(ifm) = ssgamd%ene_th_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC_DIH'
+          values(ifm) = ssgamd%kc_dih
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC0_DIH'
+          values(ifm) = ssgamd%k0_dih
+          ifm = ifm+1
+        end if
+
+        if (ssgamd%sw_lj) then
+          write(category(ifm),frmt) 'MAX_LJ'
+          values(ifm) = ssgamd%ene_max_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'MIN_LJ'
+          values(ifm) = ssgamd%ene_min_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'AVE_LJ'
+          values(ifm) = ssgamd%ene_ave_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'DEV_LJ'
+          values(ifm) = ssgamd%ene_dev_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'TH_LJ'
+          values(ifm) = ssgamd%ene_th_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC_LJ'
+          values(ifm) = ssgamd%kc_lj
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC0_LJ'
+          values(ifm) = ssgamd%k0_lj
+          ifm = ifm+1
+        end if
+
+        if (ssgamd%sw_charge) then
+          write(category(ifm),frmt) 'MAX_ELEC'
+          values(ifm) = ssgamd%ene_max_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'MIN_ELEC'
+          values(ifm) = ssgamd%ene_min_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'AVE_ELEC'
+          values(ifm) = ssgamd%ene_ave_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'DEV_ELEC'
+          values(ifm) = ssgamd%ene_dev_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'TH_ELEC'
+          values(ifm) = ssgamd%ene_th_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC_ELEC'
+          values(ifm) = ssgamd%kc_elec
+          ifm = ifm+1
+
+          write(category(ifm),frmt) 'KC0_ELEC'
+          values(ifm) = ssgamd%k0_elec
+          ifm = ifm+1
+        end if
+
+        if (ssgamdtitle) then
+            write(output%ssgamdunit,'(A,$)') title
+            do i = 1, ifm-1
+                if (i .eq. ifm-1) then
+                    write(output%ssgamdunit,frmt) category(i)
+                else
+                    write(output%ssgamdunit,frmt_cont) category(i)
+                end if
+            end do
+            write(output%ssgamdunit,'(A80)') ' --------------- --------------- --------------- --------------- ---------------'
+            ssgamdtitle = .false.
+        end if
+
+        write(output%ssgamdunit,'(6x,I10,$)') dynvars%step
+
+        do i = 1, ifm-1
+            if (i .eq. ifm-1) then
+                write(output%ssgamdunit,rfrmt) values(i)
+            else
+                write(output%ssgamdunit,rfrmt_cont) values(i)
+            end if
+        end do
+
+        write(output%ssgamdunit,'(A)') ''
+    end if
+
+    return
+
+  end subroutine output_ssgamd
+
 end module sp_output_mod
