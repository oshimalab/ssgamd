index 644ed27..485a66b 100644
--- a/src/spdyn/sp_communicate.fpp
+++ b/src/spdyn/sp_communicate.fpp
@@ -75,6 +75,9 @@ module sp_communicate_mod
   public  :: communicate_constraints_fep
   public  :: communicate_bond_fep
   public  :: update_cell_boundary_fep
+  ! ssgamd
